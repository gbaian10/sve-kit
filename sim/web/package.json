{
  "name": "@sve-kit/web",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run generate:contract && vite",
    "dev:lan": "bun run generate:contract && SVE_DEV_HTTPS=1 vite --host 0.0.0.0",
    "build:all": "bun run generate:contract && vite build",
    "preview": "vite preview",
    "typecheck": "bun run generate:contract && bun check --threads=4",
    "lint:all": "bun run lint:js && bun run lint:css",
    "lint:js": "bun run generate:contract && eslint --max-warnings=0 --no-warn-ignored --cache --cache-strategy content --cache-location node_modules/.cache/eslint/cache.json",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "test:all": "bun run generate:contract && vitest run",
    "check:all": "bun run format:check && bun run check:contract && bun run lint:all && bun run typecheck && bun run test:all && bun run knip && bun run build:all",
    "knip": "bun run generate:contract && bun run knip:dev && bun run knip:prod",
    "knip:dev": "knip",
    "knip:prod": "knip --production",
    "fixture:build": "bun run scripts/fixture/main.ts",
    "generate:contract": "bun run scripts/battle-contract/main.ts generate",
    "check:contract": "bun run generate:contract && bun run scripts/battle-contract/main.ts check && bun run scripts/battle-contract/main.ts roundtrip",
    "deploy:dev": "VITE_CDN_BASE=/cdn-preview bun run build:all && wrangler deploy --config wrangler.dev.jsonc",
    "shots": "bun run scripts/screenshots/main.ts",
    "bench:catalog": "bun run scripts/catalog/main.ts",
    "check:drawer": "bun run scripts/drawer-check/main.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "clsx": "^2.1.1",
    "i18next": "^27.0.1",
    "lucide-react": "^1.70.0",
    "onnxruntime-web": "^1.31.1",
    "p-queue": "^10.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.0",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "jsonc-parser": "^3.3.1",
    "knip": "^6.44.2",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
