{
  "name": "@sve-kit/web",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run schema:compile && vite",
    "build": "bun run schema:compile && vite build",
    "preview": "bun run schema:compile && vite preview",
    "typecheck": "bun run schema:compile && tsc -b",
    "lint": "bun run lint:js && bun run lint:css",
    "lint:js": "eslint --max-warnings=0 .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run schema:compile && vitest run",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run knip && bun run build",
    "knip": "bun run schema:compile && knip",
    "fixture:build": "bun run schema:compile && bun run scripts/fixture/main.ts",
    "fixture:local": "bun run schema:compile && bun run scripts/fixture/local-main.ts",
    "schema:compile": "bun run scripts/schema/main.ts",
    "deploy:dev": "wrangler deploy --config wrangler.dev.jsonc"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "jsonc-parser": "^3.3.1",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.48.0",
    "p-queue": "^9.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.147.0"
  }
}
