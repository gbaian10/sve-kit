            "qa": [
              {
                "title": "Q1580 (Oct. 17, 2025)",
                "question": "My leader's defense is at 1, and I have an Ancient Protector on the field. My opponent has a Exterminus Weapon on the field that is destroyed during my turn, dealing 4 damage to my leader with its Last Words. My leader's defense becomes -3, triggering Ancient Protector's ability and changing my leader's defense back to 1. Have I met the requirements to play this follower's Fanfare ability?",
                "answer": "Yes, that's correct. Your leader's defense changing from -3 to 1 counts as gaining at least 4 defense."
              },
              {
                "title": "Q1579 (Oct. 17, 2025)",
                "question": "If my leader gains defense in multiple separate instances in the same turn that add up to at least 4, have I still met the requirements to play this follower's Fanfare ability?",
                "answer": "Yes, you have."
              },
              {
                "title": "Q1578 (Oct. 17, 2025)",
                "question": "If my leader takes 4 damage after gaining 4 defense in the same turn, have I still met the requirements to play this follower's Fanfare ability?",
                "answer": "Yes, you have."
              },
              {
                "title": "Q1577 (Oct. 17, 2025)",
                "question": "If my leader has gained at least 4 defense this turn, but I can't select an enemy follower on the field, can I still play this follower's Fanfare to draw a card?",
                "answer": "No, you can't."
              },
              {
                "title": "Q1576 (Oct. 17, 2025)",
                "question": "If my leader hasn't gained at least 4 defense this turn, can I still play this follower's Fanfare to draw a card?",
                "answer": "No, you can't."
              }
