            "errata_url": null,
            "notes": [],
            "qa": [
              {
                "title": "Q1117 (Jan. 31, 2025)",
                "question": "When playing this follower's On Evolve ability, can I select a card and its alternate-art version with a different name, such as Globe of the Starways and Dark Charisma, and add them both to my hand?",
                "answer": "No, you can't."
              },
              {
                "title": "Q1116 (Jan. 31, 2025)",
                "question": "When playing this follower's On Evolve ability, if I select two 1-cost cards and one 2-cost card with different names in my cemetery, can I add the 1-cost cards to my hand?",
                "answer": "No. You can only add the cards to your hand if all 3 cards with different names cost the same number of play points."
              },
              {
                "title": "Q1115 (Jan. 31, 2025)",
                "question": "If I have 2 or less cards in my cemetery, can I still add them to my hand with this follower's On Evolve ability?",
                "answer": "No. If you can't select 3 cards in your cemetery, you can't play this follower's On Evolve ability."
              }
            ],
