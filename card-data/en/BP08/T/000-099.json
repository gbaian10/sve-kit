            "qa": [
              {
                "title": "Q1134 (Jan. 31, 2025)",
                "question": "When I play this follower, will it trigger abilities that mention Puppets, such as Noah, Vengeful Puppeteer's ability?",
                "answer": "Yes, it will."
              },
              {
                "title": "Q1132 (Jan. 31, 2025)",
                "question": "Can an ability that references Neutral followers on the field also reference this follower?",
                "answer": "No. Having the additional card name Puppet doesn't mean this follower also has the same card information as the Puppet token, such as its cost and class."
              },
              {
                "title": "Q1131 (Jan. 31, 2025)",
                "question": "What does \"While this card is on the field, its name is also Puppet\" mean?",
                "answer": "While this follower is on the field, it has the additional card name Puppet, and any ability that references cards named Puppet can also reference this follower."
              }
            ],
