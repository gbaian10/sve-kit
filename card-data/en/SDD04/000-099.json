              {
                "name": "Filene, Whitefrost Dragonewt",
                "info": {
                  "Card Set": "Showdown Deck: Dragoncraft",
                  "Card Type": "Follower",
                  "Class": "Dragoncraft",
                  "Format": "Any",
                  "Rarity": "Legendary",
                  "Trait": "Dragonewt"
                },
                "stats": {
                  "cost": "1",
                  "hp": "3",
                  "power": "1"
                },
                "text": "{icon_fanfare|[fanfare]} Select an enemy follower on the field and engage it. It doesn't refresh during its controller's next start phase.\n{icon_fanfare|[fanfare]} If Overflow is active for you, search your deck for a Whitefrost Whisper, put it into your EX area, then shuffle.",
                "sections": [],
                "raw_text": "{icon_fanfare|[fanfare]} Select an enemy follower on the field and engage it. It doesn't refresh during its controller's next start phase.\n{icon_fanfare|[fanfare]} If Overflow is active for you, search your deck for a Whitefrost Whisper, put it into your EX area, then shuffle.",
                "speech": null,
                "illustrator": "Ponzu",
                "image": "/wordpress/wp-content/images/cardlist/SDD04/SDD04-001EN.png",
                "trait_raw": "Dragonewt",
                "traits": [
                  "Dragonewt"
                ]
              }
            ],
            "release_date": "Mar. 20, 2026",
            "errata_url": null,
            "notes": [],
            "qa": [
              {
                "title": "Q820 (Aug. 8, 2024)",
                "question": "If this follower's second Fanfare ability triggers, and I have no copies of Whitefrost Whisper in my deck, do I still have to search my deck?",
                "answer": "Yes. After looking through your deck, you would shuffle it without adding a Whitefrost Whisper to your EX area."
              },
              {
                "title": "Q819 (Aug. 8, 2024)",
                "question": "I select an enemy follower with this follower's first Fanfare ability, and then steal that enemy follower with an Angel of Chaos's activated ability. If it's engaged at the start of my next turn, does \"It doesn't refresh during its controller's next start phase\" apply to me?",
                "answer": "No. It applies to the controller at the time the ability was played. In this case, because this follower's Fanfare ability was played before you became the stolen follower's controller, it refreshes as normal during your next start phase."
              },
              {
                "title": "Q818 (Aug. 8, 2024)",
                "question": "If I select an engaged enemy follower with this follower's first Fanfare ability, will it refresh at the start of its controller's next turn?",
                "answer": "No. Although the Fanfare ability's \"engage it\" effect will not apply to a follower that is already engaged, the \"It doesn't refresh during its controller's next start phase\" will still apply."
              }
            ],
            "products_ref": "products-27295d78cc74f2b3",
