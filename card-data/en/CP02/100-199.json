                "stats": {
                  "cost": "10",
                  "hp": "5",
                  "power": "5"
                },
                "text": "When playing this card, banish 3 Cute cards, 3 Cool cards, and 3 Passion cards from your cemetery: This card costs 9 less to play.",
                "sections": [
                  "Storm. Bane. Ward."
                ],
                "raw_text": "When playing this card, banish 3 Cute cards, 3 Cool cards, and 3 Passion cards from your cemetery: This card costs 9 less to play.\n----------\nStorm. Bane. Ward.",
                "speech": null,
                "illustrator": null,
                "image": "/wordpress/wp-content/images/cardlist/CP02/CP02-103EN.png",
                "trait_raw": "iM@S CG / Cute / Cool / Passion",
