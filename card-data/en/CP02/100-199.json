                ]
              }
            ],
            "release_date": "Oct. 11, 2024",
            "errata_url": null,
            "notes": [],
            "qa": [
              {
                "title": "Q954 (Oct. 8, 2024)",
                "question": "Can a card that has the Cute, Cool, and Passion traits satisfy abilities that only mention one of those traits, such as \"select a Cool follower in your cemetery and summon it\"?",
                "answer": "Yes, it can."
              },
              {
                "title": "Q953 (Oct. 8, 2024)",
                "question": "Can I banish 3 cards that each have the Cute, Cool, and Passion traits, such as New Wave, as part of this card's additional cost to play it for 9 less play points?",
                "answer": "No. A card with all three traits will only count as one card. It may be counted towards any of the trait cards, but you will still need to banish a total of nine cards, three from each trait, to pay the additional cost."
              }
            ],
