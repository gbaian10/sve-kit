            "errata_url": null,
            "notes": [],
            "qa": [
              {
                "id": "Q1713",
                "date": "2024-10-15",
                "question": "カード名1つを指定する際、完全に一致した正式名称を指定する必要がありますか？",
                "answer": "いいえ。カードを特定できる情報を示し、お互いのプレイヤーが1種を特定できる場合は正式名称を指定する必要はありません。コミュニケーションを取りながらバトルを行いましょう。\nまた、公認・公式大会においてカードの名称がわからない場合、各大会規約に従って、カードを特定できる情報を示すことでジャッジにカード名を教えてもらうことができます。"
              },
              {
                "id": "Q1712",
                "date": "2024-10-15",
                "question": "カード名1つを指定する際、『フェアリー』などのトークン・カードのカード名を指定することができますか？",
                "answer": "はい。トークン・カードのカード名を指定することができます。"
              },
              {
                "id": "Q1711",
                "date": "2024-10-15",
                "question": "カード名1つを指定する際、『澄明なる頭脳・博衣こより』などのコラボ名を指定することができますか？",
                "answer": "いいえ。コラボ名はカード名ではないので、指定することができません。\nまた、『陰陽の開祖・クオン』を指定して、『澄明なる頭脳・博衣こより』を公開した場合、指定したカード名を持つため、2枚引くことができます。"
              },
              {
                "id": "Q1710",
                "date": "2024-10-15",
                "question": "カードを公開して1枚引く場合、引くカードはその公開したカードですか？",
                "answer": "はい。公開したカードです。2枚引く場合、公開したカードに加えてもう1枚カードを引きます。"
              }
            ],
