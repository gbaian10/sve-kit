          "record": {
            "number": "EBD03-T05",
            "faces": [
              {
                "name": "魔導列車",
                "card_class": "ナイトメア",
                "card_type": "アミュレット・トークン",
                "traits": [
                  "荒野",
                  "乗物"
                ],
                "rarity": "-",
                "product": "EXビギナーデッキ「ナイトメア」",
                "title": null,
                "cost": "5",
                "power": "4",
                "hp": "5",
                "text": "{起動}{コスト1}場のフォロワーを元のコストの合計が5以上になるように好きな枚数{アクト}：これを操縦する。（このターン、これを{攻撃力}4/{体力}5のフォロワーにする）\n【突進】\n【攻撃時】相手の場のアクト状態のフォロワー1体を選ぶ。それを破壊する。自分のリーダーは{体力}+2する。",
                "sections": [],
                "flavor": null,
                "illustrator": "おにねこ",
                "image": "/wordpress/wp-content/images/cardlist/EBD03/ebd03-t05.png",
                "trait_raw": "荒野・乗物"
              }
            ],
            "release_date": "2025-11-21",
            "errata_url": null,
            "notes": [],
            "qa": [
              {
                "id": "Q1584",
                "date": "2024-08-20",
                "question": "相手の場のアクト状態のフォロワーを選ぶことができない場合、このフォロワーの【攻撃時】能力をプレイして自分のリーダーの体力を+2することができますか？",
                "answer": "いいえ。相手の場のフォロワーを選ぶことができない場合、このフォロワーの【攻撃時】能力をプレイすることができず、自分のリーダーの体力を+2することができません。"
              },
              {
                "id": "Q1583",
                "date": "2024-08-20",
                "question": "操縦し、フォロワーになっている状況で、何らかの能力により攻撃力や体力を+、もしくは-した場合、次の自分のターンに再度操縦した際、攻撃力と体力はどうなりますか？",
                "answer": "再度操縦した際はカードに記載されている攻撃力と体力になるため、直前に操縦した際に攻撃力や体力を増減していたとしても引き継がれません。"
              },
              {
                "id": "Q1582",
                "date": "2024-08-20",
                "question": "操縦し、フォロワーになっている状況で、何らかの能力により【オーラ】を付与した場合、ターン終了時にアミュレットに戻った際にその【オーラ】はどうなりますか？",
                "answer": "【オーラ】が残り続けます。次の自分のターンに再度操縦した際も【オーラ】を持ったままフォロワーになります。"
              },
              {
                "id": "Q1581",
                "date": "2024-08-20",
                "question": "「これを操縦する。」とは何ですか？",
                "answer": "「これを操縦する。」とは、そのターン、それをカードに記載されている攻撃力と体力を持つフォロワーにすることを意味します。\n「これは操縦する。」を持つカードが場に出たターンに操縦してフォロワーになった場合、通常のフォロワーと同様に、そのターンは相手を攻撃することができません。（【疾走】を持っている場合、相手のリーダーと相手のアクト状態のフォロワーに、【突進】を持っている場合、相手のアクト状態のフォロワーに攻撃できます。）\n場に出たターンの次のターン以降に操縦してフォロワーになった場合は、相手を攻撃することができます。"
              }
            ],
            "products_ref": "products-b3eaf219c905ac85",
            "related_cards": []
          }
        }
