      "documents": {
        "documents-57e35899624daded": {
          "region": "jp",
          "record": {
            "number": "BP03-109",
            "faces": [
              {
                "name": "カオティックエンジェル",
                "card_class": "ニュートラル",
                "card_type": "フォロワー",
                "traits": [
                  "天使",
                  "堕天使"
                ],
                "rarity": "LG",
                "product": "ブースターパック第3弾「FLAME OF LAEVATEINN / フレイム・オブ・レーヴァテイン」",
                "title": null,
                "cost": "7",
                "power": "5",
                "hp": "5",
                "text": "【守護】\n{起動}墓場の堕天使・カード3枚を消滅：相手のフォロワー1体を選ぶ。それを奪い、スタンドする。この能力は1ターンに1回使える。（奪ったフォロワーは自分の場に移す。それが場を離れたとき、相手の領域に戻す）",
                "sections": [],
                "flavor": null,
                "illustrator": "虹原",
                "image": "/wordpress/wp-content/images/cardlist/BP03/bp03-109.png",
                "trait_raw": "天使・堕天使"
              }
            ],
            "release_date": "2022-12-16",
            "errata_url": null,
            "notes": [],
            "qa": [
              {
                "id": "Q545",
                "date": "2022-12-09",
                "question": "「奪う」とは何ですか？",
                "answer": "「奪う」とは相手の場のカードを自分の場へ移動し、そのカードやそのカードの持つ能力を使用することができる能力です。\n奪ったフォロワーが場から場以外の領域へ移動する場合、持ち主の領域へ移動します。"
              },
              {
                "id": "Q544",
                "date": "2022-12-09",
                "question": "このフォロワーの能力で、進化後のフォロワーや出走したフォロワーを奪うことはできますか？",
                "answer": "はい。奪うことができます。奪った後も、進化している状態や出走している状態を引き継ぎます。"
              },
              {
                "id": "Q543",
                "date": "2022-12-09",
                "question": "このフォロワーの能力で、相手の場のフォロワー・トークンを奪うことはできますか？",
                "answer": "はい。奪うことができます。"
              },
              {
                "id": "Q542",
                "date": "2022-12-09",
                "question": "《ファンファーレ》能力を持つフォロワーを奪ったとき、そのフォロワーの《ファンファーレ》能力は誘発しますか？",
                "answer": "いいえ。誘発しません。"
              },
              {
                "id": "Q541",
                "date": "2022-12-09",
                "question": "カードや能力により、何らかの効果が適用されているフォロワーやダメージを受けているフォロワーを奪った場合、その効果やダメージは継続しますか？",
                "answer": "はい。継続します。"
              },
              {
                "id": "Q540",
                "date": "2022-12-09",
                "question": "相手に奪われたフォロワーを、このフォロワーの能力で奪うことはできますか？",
                "answer": "はい。奪うことができます。"
              },
              {
                "id": "Q539",
                "date": "2022-12-09",
                "question": "自分の場が上限のとき、このフォロワーの能力で相手のフォロワーを奪うことはできますか？",
                "answer": "いいえ。奪うことはできませんが、起動能力自体はプレイすることができます。その場合、自分はコストである「墓場の堕天使・カード3枚を消滅」を支払いますが、相手のフォロワーを奪うことはできず、そのフォロワーは相手の場でスタンドします。"
              },
              {
                "id": "Q538",
                "date": "2022-12-09",
                "question": "奪ったフォロワーが《進化》能力や《食事》能力を持つ場合、そのフォロワーは進化または出走することはできますか？",
                "answer": "はい。奪ったプレイヤーのエボルヴデッキに関連するカードがあるなら、進化または出走することができ、奪ったプレイヤーのエボルヴデッキのカードを使用します。また、進化または出走は1ターンに1回のみすることができます。"
              },
              {
                "id": "Q537",
                "date": "2022-12-09",
                "question": "奪ったフォロワーは、奪ったターンに攻撃することはできますか？",
                "answer": "いいえ。攻撃することはできません。"
              },
              {
                "id": "Q536",
                "date": "2022-12-09",
                "question": "奪ったフォロワーが【疾走】や【突進】を持っているとき、そのフォロワーは奪ったターンに攻撃することはできますか？",
                "answer": "はい。【疾走】や【突進】それぞれの能力に従って、攻撃することができます。"
              },
              {
                "id": "Q535",
                "date": "2022-12-09",
                "question": "奪ったフォロワーが「これは相手を攻撃できない。」を持つ場合、そのフォロワーは持ち主であるプレイヤーを攻撃することはできますか？",
                "answer": "いいえ。攻撃することはできません。"
              },
              {
                "id": "Q534",
                "date": "2022-12-09",
                "question": "奪ったフォロワーが進化しているとき、そのフォロワーは奪ったターンに攻撃することはできますか？",
                "answer": "いいえ。奪ったフォロワーが【疾走】や【突進】を持っていない限り、進化しているフォロワーが攻撃することはできません。\n進化したフォロワーがアクト状態の相手のフォロワーに攻撃することができるというルールは、そのターン中に進化することによって可能となるルールです。"
              },
              {
                "id": "Q533",
                "date": "2022-12-09",
                "question": "《食事》能力で出走した相手の『ハルウララ』を奪った場合、そのターン、その『ハルウララ』はアクト状態の相手のフォロワーを攻撃することはできますか？",
                "answer": "はい。出走したフォロワーは【突進】を持ち、相手の場から自分の場に移動した後も引き続き【突進】を持つため、相手のフォロワーに攻撃することができます。"
              },
              {
                "id": "Q532",
                "date": "2022-12-09",
                "question": "奪ったフォロワーが破壊されたとき、破壊されたフォロワーはどこに置かれますか？",
                "answer": "持ち主の墓場に置かれます。"
              },
              {
                "id": "Q531",
                "date": "2022-12-09",
                "question": "奪ったフォロワーが消滅したとき、消滅したフォロワーはどこに置かれますか？",
                "answer": "持ち主の消滅領域に置かれます。"
              },
              {
                "id": "Q530",
                "date": "2022-12-09",
                "question": "奪ったフォロワーが手札に戻ったとき、そのフォロワーはどちらの手札に戻りますか？",
                "answer": "持ち主の手札に戻ります。"
              },
              {
                "id": "Q529",
                "date": "2022-12-09",
                "question": "奪ったフォロワーがEXエリアに置かれるとき、そのフォロワーはどちらのEXエリアに置かれますか？",
                "answer": "持ち主のEXエリアに置かれます。"
              },
              {
                "id": "Q528",
                "date": "2022-12-09",
                "question": "奪ったフォロワーが進化または出走しており、そのフォロワーが場を離れるとき、そのフォロワーのエボルヴフォロワーや『にんじん』はどこに置かれますか？",
                "answer": "持ち主のエボルヴデッキに表向きで置かれます。"
              },
              {
                "id": "Q527",
                "date": "2022-12-09",
                "question": "奪ったフォロワーが破壊されたとき、そのフォロワーの《ラストワード》能力はどちらのプレイヤーがプレイしますか？",
                "answer": "奪ったフォロワーの《ラストワード》能力は、奪ったプレイヤーがプレイします。"
              },
              {
                "id": "Q526",
                "date": "2022-12-09",
                "question": "相手から奪った『ドラゴンナイト・アイラ』が破壊され《ラストワード》能力をプレイするとき、処理はどうなりますか？",
                "answer": "奪ったプレイヤーがPP最大値を+1します。"
              },
              {
                "id": "Q525",
                "date": "2022-12-09",
                "question": "相手から奪った『レオニダス（EVOLVE）』が破壊され《ラストワード》能力をプレイするとき、処理はどうなりますか？",
                "answer": "奪ったプレイヤーの場に『レオニダスの意志』が出ます。"
              },
              {
                "id": "Q524",
                "date": "2022-12-09",
                "question": "相手から奪った『冥守の戦士・カムラ』が破壊され《ラストワード》能力をプレイするとき、処理はどうなりますか？",
                "answer": "奪ったプレイヤーが相手のフォロワー1体を選んで破壊し、奪ったプレイヤーのリーダーが《体力》+Xします。"
              },
              {
                "id": "Q523",
                "date": "2022-12-09",
                "question": "相手から奪った『デュエリストモルディカイ』が破壊され《ラストワード》能力をコストを支払ってプレイするとき、処理はどうなりますか？",
                "answer": "奪ったプレイヤーがコストである「リーダーの体力-3」を支払い、持ち主の場に『デュエリスト・モルディカイ』が出ます。\n以下、処理の順を詳細に説明します。\n①破壊された『デュエリスト・モルディカイ』は、奪ったプレイヤーの場から持ち主の墓場へ移動します。\n②『デュエリスト・モルディカイ』の《ラストワード》能力が誘発し、奪ったプレイヤーがその能力をプレイします。\n③奪ったプレイヤーがコストを支払うかどうか選択します。コストを支払う場合、奪ったプレイヤーがコストを支払い、その効果を処理します。\n④効果の処理を行います。この時点で『デュエリスト・モルディカイ』は持ち主の墓場に移動しているので、『デュエリスト・モルディカイ』は持ち主の場に出ます。"
              },
              {
                "id": "Q522",
                "date": "2022-12-09",
                "question": "相手から奪った『ダークアリス』が破壊され《ラストワード》能力をコストを支払ってプレイするとき、処理はどうなりますか？",
                "answer": "奪ったプレイヤーがコストである「デッキの上10枚を消滅」を支払い、持ち主の場に『ダークアリス』が出て、奪ったプレイヤーが自分の手札1枚を捨てます。\n以下、処理の順を詳細に説明します。\n①破壊された『ダークアリス』は、奪ったプレイヤーの場から持ち主の墓場へ移動します。\n②『ダークアリス』の《ラストワード》能力が誘発し、奪ったプレイヤーがその能力をプレイします。\n③奪ったプレイヤーがコストを支払うかどうか選択します。コストを支払う場合、奪ったプレイヤーがコストを支払い、その効果を処理します。\n④効果の処理を行います。この時点で『ダークアリス』は持ち主の墓場に移動しているので、『ダークアリス』は持ち主の場に出ます。\nまた、この《ラストワード》能力をプレイしているのは奪ったプレイヤーなので、奪ったプレイヤーが自分の手札1枚を捨てます。"
              },
              {
                "id": "Q521",
                "date": "2022-12-09",
                "question": "相手から奪った『ブロッサムウルフ・スレイド』が手札に戻るとき、処理はどうなりますか？",
                "answer": "相手から奪った『ブロッサムウルフ・スレイド』が手札に戻るとき、『ブロッサムウルフ・スレイド』は持ち主の手札に戻り、『ブロッサムウルフ・スレイド』の「これが場から手札に戻ったとき」の能力は奪ったプレイヤーがプレイします。"
              },
              {
                "id": "Q520",
                "date": "2022-12-09",
                "question": "このフォロワーの能力で相手の『ランスリザード』を目標に選んで奪ったとき、『ランスリザード』の「自分のターンごとに1回、これが能力によって選ばれたとき」の能力は誘発しますか？",
                "answer": "いいえ。条件を満たしたタイミングでは相手のターンで選ばれているため、誘発しません。"
              },
              {
                "id": "Q519",
                "date": "2022-12-09",
                "question": "自分のカードや能力のコストで自分の場のフォロワーを墓場に置くとき、奪ったフォロワーをコストの支払いに使用することはできますか？",
                "answer": "はい。使用することができます。"
              },
              {
                "id": "Q518",
                "date": "2022-12-09",
                "question": "このフォロワーが場に2体いるとき、このフォロワーの起動能力をそれぞれプレイすることはできますか？",
                "answer": "はい。プレイすることができます。"
              },
              {
                "id": "Q517",
                "date": "2022-12-09",
                "question": "奪ったフォロワーがトークンを出すとき、そのトークンを奪ったプレイヤーが持っていない場合はどうなりますか？",
                "answer": "奪ったプレイヤーが指定のトークンを持っていない場合、お互いのプレイヤーが指定のトークンであることを認識できる他の物で代用してください。"
              }
            ],
