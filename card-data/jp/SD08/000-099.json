                "illustrator": "みけぼし",
                "image": "/wordpress/wp-content/images/cardlist/SD08/sd08-002.png",
                "trait_raw": "竜使い・武闘竜人・キラー"
              }
            ],
            "release_date": "2025-06-27",
            "errata_url": null,
            "notes": [],
            "qa": [
              {
