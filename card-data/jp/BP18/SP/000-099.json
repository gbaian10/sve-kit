          "region": "jp",
          "record": {
            "number": "BP18-SP01",
            "faces": [
              {
                "name": "カースドクイーン・ナハト・ナハト",
                "card_class": "ロイヤル",
                "card_type": "フォロワー",
                "traits": [
                  "荒野",
                  "指揮官"
                ],
                "rarity": "SP",
                "product": "ブースターパック「新約都市・透京」",
                "title": null,
                "cost": "4",
                "power": "3",
                "hp": "5",
                "text": "{ファンファーレ}自分のデッキから元のコスト1の{ロイヤル}カード1枚を探し、EXエリアに置く。\n{起動}{コスト0}：相手の場のフォロワー1体を選ぶ。それをアクトする。次のそれのプレイヤーのターン終了時まで、それを【箱詰め】状態にする。この能力は1ターンに1回使える。",
                "sections": [],
                "flavor": null,
                "illustrator": "ぽんず",
                "image": "/wordpress/wp-content/images/cardlist/BP18/bp18-sp01.png",
                "trait_raw": "荒野・指揮官"
              }
            ],
            "release_date": "2025-11-21",
            "errata_url": null,
            "notes": [],
            "qa": [
              {
                "id": "Q1718",
                "date": "2024-11-08",
                "question": "《憑依》し、ドライブを持った相手の場のフォロワーを【箱詰め】状態にしました。その後、相手のターンが終了し【箱詰め】状態が解除された場合、そのフォロワーの【突進】や【シングルドライブ】はどうなりますか？",
                "answer": "【箱詰め】状態の間は【突進】や【シングルドライブ】を失いますが、【箱詰め】状態が解除された場合、持っていた【突進】や【シングルドライブ】などの能力は元に戻り有効となります。"
              },
              {
                "id": "Q1717",
                "date": "2024-11-08",
                "question": "『死の祝福』によって、【守護】を持った相手の場のフォロワーを【箱詰め】状態にしました。その後、相手のターンが終了し【箱詰め】状態が解除された場合、『死の祝福』によって持った【守護】はどうなりますか？",
                "answer": "【箱詰め】状態の間は【守護】を失いますが、【箱詰め】状態が解除された場合、持っていた【守護】などの能力は元に戻り有効となります。"
              },
              {
                "id": "Q1502",
                "date": "2024-08-20",
                "question": "『カースドクイーン・ナハト・ナハト』の《起動》能力によって、相手の場の『カオスルーラー・アイシィレンドリング』を選んだ場合、『カオスルーラー・アイシィレンドリング』の「これがアクトしたとき、～」という能力は誘発しますか？",
                "answer": "はい。誘発します。誘発したこの能力は、チェックタイミングで解決します。"
              },
              {
                "id": "Q1501",
                "date": "2024-08-20",
                "question": "《起動》能力によって、アクト状態の相手の場のフォロワーを選んだ場合でも、次のそれのプレイヤーのターン終了時まで、それを【箱詰め】状態にすることができますか？",
                "answer": "はい。アクト状態の相手の場のフォロワーを選んだ場合でも、次のそれのプレイヤーのターン終了時まで、それを【箱詰め】状態にすることができます。\nアクト状態の相手の場のフォロワーを選んだ場合、「それをアクトする。」は既にアクト状態なため単に行われず、続く効果である「次のそれのプレイヤーのターン終了時まで、それを【箱詰め】状態にする。」が適用されます。"
              },
              {
                "id": "Q1500",
                "date": "2024-08-20",
                "question": "『ドラゴウェポン』の効果によって武装・タイプを持ったフォロワーが【箱詰め】状態になった場合、そのフォロワーは武装・タイプを失いますか？",
                "answer": "いいえ。失いません。"
              },
              {
                "id": "Q1499",
                "date": "2024-08-20",
                "question": "【箱詰め】状態のフォロワーに『守護の陽光』の《ファンファーレ》能力で【守護】を付与することはできますか？",
                "answer": "はい。【箱詰め】状態のフォロワーに対して【守護】などの能力を付与することができます。"
              },
              {
                "id": "Q1498",
                "date": "2024-08-20",
                "question": "【箱詰め】状態のフォロワーが場から手札に戻った場合、そのフォロワーの「これが場から手札に戻ったとき、」という能力は誘発しますか？",
                "answer": "いいえ。能力を失っているので誘発しません。"
              },
              {
                "id": "Q1497",
                "date": "2024-08-20",
                "question": "【箱詰め】状態のフォロワーが墓場に置かれた場合、そのフォロワーの《ラストワード》能力は誘発しますか？",
                "answer": "いいえ。能力を失っているので《ラストワード》能力は誘発しません。"
              }
            ],
