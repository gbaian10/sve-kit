    {
      "card_no": "CP02-SP02",
      "documents": {
        "documents-a3da8816e9cc6c30": {
          "region": "jp",
          "record": {
            "number": "CP02-SP02",
            "faces": [
              {
                "name": "アナスタシア",
                "card_class": "エルフ",
                "card_type": "フォロワー",
                "traits": [
                  "デレマス",
                  "クール"
                ],
                "rarity": "SP",
                "product": "コラボパック「アイドルマスター シンデレラガールズ」",
                "title": "アイドルマスター シンデレラガールズ",
                "cost": "5",
                "power": "2",
                "hp": "4",
                "text": "自分のターン中、自分がカードをプレイしたとき、このターン中に3枚目のカードなら、自分のPPを2回復する。このターン中に5枚目のカードなら、自分の場のフォロワーすべては{攻撃力}+1/{体力}+1する。\n{ファンファーレ}自分のPPを2回復する。",
                "sections": [],
                "flavor": null,
                "illustrator": null,
                "image": "/wordpress/wp-content/images/cardlist/CP02/cp02-sp02.png",
                "trait_raw": "デレマス・クール"
              }
            ],
            "release_date": "2023-08-25",
            "errata_url": null,
            "notes": [],
            "qa": [
              {
                "id": "Q972",
                "date": "2023-09-15",
                "question": "自分のターン中、そのターンの3枚目以降のカードとして『アナスタシア』をプレイし、その後、『アナスタシア』自身を含めてカードを3枚プレイしたとき、『アナスタシア』の「自分のターン中、自分がカードをプレイしたとき、このターン中に3枚目のカードなら、～」という能力によって、自分のPPを2回復することができますか？",
                "answer": "いいえ。自分のPPを2回復することができません。\n『アナスタシア』の能力は『アナスタシア』が場に出てからではなく、そのターン中にプレイしたカードの枚数を参照します。\n自分のターン中、そのターンの3枚目以降のカードとして『アナスタシア』をプレイした場合、すでにそのターンにカードを3枚プレイしているため、その後、『アナスタシア』自身を含めてカードを3枚プレイしたとしても、『アナスタシア』の「自分のターン中、自分がカードをプレイしたとき、このターン中に3枚目のカードなら、～」という能力によって、自分のPPを2回復することができません。"
              },
              {
                "id": "Q971",
                "date": "2023-09-15",
                "question": "自分の場に『アナスタシア』と『フェアリー』がいる状況で、自分のターン中、そのターンの5枚目のカードとして『自然の導き』を『アナスタシア』を目標に選び、プレイしました。この場合、『アナスタシア』の「自分のターン中、自分がカードをプレイしたとき、～」という能力によって、自分の場の『フェアリー』の攻撃力と体力を+1することができますか？",
                "answer": "はい。自分のターン中、そのターンの5枚目のカードとして、自分の場の『アナスタシア』を目標に『自然の導き』をプレイし、『アナスタシア』を手札に戻した場合でも、『自然の導き』をプレイしたときに誘発した『アナスタシア』の「自分のターン中、自分がカードをプレイしたとき、～」という能力によって、自分の場の『フェアリー』の攻撃力と体力を+1することができます。"
              },
              {
                "id": "Q970",
                "date": "2023-09-15",
                "question": "自分のターン中、そのターンの4枚目のカードとして『アナスタシア』をプレイし、その後、『フェアリー』を1枚プレイしたとき、『アナスタシア』の「自分のターン中、自分がカードをプレイしたとき、～」という能力によって、自分の場のフォロワーすべての攻撃力と体力を+1することができますか？",
                "answer": "はい。自分のターン中、そのターンの4枚目のカードとして『アナスタシア』をプレイし、その後、『フェアリー』を1枚プレイしたとき、その『フェアリー』は、そのターンの5枚目のカードなので、『アナスタシア』の「自分のターン中、自分がカードをプレイしたとき、～」という能力によって、自分の場のフォロワーすべての攻撃力と体力を+1することができます。"
              },
              {
                "id": "Q916",
                "date": "2023-08-18",
                "question": "自分のターン中、手札から『アナスタシア』をプレイし、次に手札から『荒木比奈』をプレイしました。その後、自分の場の『荒木比奈』を進化させ、【進化時】能力によって自分の墓場の『アンジェリックメイド』をプレイしました。この場合、『アナスタシア』の「自分のターン中、自分がカードをプレイしたとき、このターン中に3枚目のカードなら、～」という能力は誘発しますか？",
                "answer": "はい。誘発します。また、3枚目のカードとして『アンジェリックメイド』をプレイしているので、自分のPPを2回復します。"
              },
              {
                "id": "Q915",
                "date": "2023-08-18",
                "question": "自分の場に『アナスタシア』がいる状況で、自分のターン中、そのターンの5枚目のカードとしてフォロワーをプレイした場合、そのフォロワーも攻撃力と体力を+1しますか？",
                "answer": "はい。そのターンの5枚目のカードとしてプレイしたフォロワーも、攻撃力と体力を+1します。"
              },
              {
                "id": "Q914",
                "date": "2023-08-18",
                "question": "自分のターン中、手札から『アナスタシア』をプレイし、次に手札から『喜多見柚』をプレイしました。その後、自分の場の『喜多見柚』を進化させた場合、『アナスタシア』の「自分のターン中、自分がカードをプレイしたとき、このターン中に3枚目のカードなら、～」という能力は誘発しますか？",
                "answer": "いいえ。フォロワーの進化はカードのプレイに含まないので、誘発しません。"
              },
              {
                "id": "Q913",
                "date": "2023-08-18",
                "question": "自分のターン中、そのターンの3枚目のカードとして『アナスタシア』をプレイした場合、その『アナスタシア』自身が持つ「自分のターン中、自分がカードをプレイしたとき、このターン中に3枚目のカードなら、～」という能力は誘発しますか？",
                "answer": "いいえ。『アナスタシア』をプレイしたとき、その『アナスタシア』自身はまだ自分の場におらず、その能力が有効ではないため誘発しません。（この能力によって、自分のPPを2回復することはできません。《ファンファーレ》能力は誘発し、自分のPPを2回復します。）"
              }
            ],
