    {
      "card_no": "CP02-SP11",
      "documents": {
        "documents-389fd309fd343363": {
          "region": "jp",
          "record": {
            "number": "CP02-SP11",
            "faces": [
              {
                "name": "高垣楓",
                "card_class": "ビショップ",
                "card_type": "フォロワー",
                "traits": [
                  "デレマス",
                  "クール"
                ],
                "rarity": "SP",
                "product": "コラボパック「アイドルマスター シンデレラガールズ」",
                "title": "アイドルマスター シンデレラガールズ",
                "cost": "5",
                "power": "3",
                "hp": "5",
                "text": "【守護】\n自分のエンドフェイズが来たとき、自分のリーダーの{体力}5以下なら、自分のリーダーは{体力}+5する。1枚引く。\n{ファンファーレ}相手の場のフォロワー1体を選ぶ。それを消滅させる。\n{起動}{コスト1}【レッスン_1】：これは【オーラ】を持つ。",
                "sections": [],
                "flavor": null,
                "illustrator": null,
                "image": "/wordpress/wp-content/images/cardlist/CP02/cp02-sp11.png",
                "trait_raw": "デレマス・クール"
              }
            ],
            "release_date": "2023-08-25",
            "errata_url": null,
            "notes": [],
            "qa": [
              {
                "id": "Q965",
                "date": "2023-08-18",
                "question": "「自分のエンドフェイズが来たとき、～」という能力を持つカードが自分の場に複数枚ある状況で、エンドフェイズを迎えた場合、その誘発した能力はどのような順番で解決しますか？",
                "answer": "任意の順番で解決することができます。\n自分のエンドフェイズを迎えた場合、「自分のエンドフェイズが来たとき、～」という能力がすべて誘発し、待機状態になります。その後、待機状態になった能力を任意の順で1つずつ解決します。"
              },
              {
                "id": "Q964",
                "date": "2023-08-18",
                "question": "自分のリーダーの体力が5、自分の場に『高垣楓』が2体いる状況でエンドフェイズを迎えました。誘発したそれぞれの能力を解決する場合、どのようになりますか？",
                "answer": "最終的に、自分のリーダーは体力+5し、1枚引きます。\n処理順は以下になります。\n\n①エンドフェイズが来たとき、それぞれの『高垣楓』の能力が誘発し、待機状態になります。\n②待機状態になったそれぞれの能力を順に解決します。\n③1つ目の『高垣楓』の能力を解決します。自分のリーダーの体力が5なので、自分のリーダーは体力+5し、1枚引きます。\n④2つ目の『高垣楓』の能力を解決します。自分のリーダーの体力が10なので、何も行いません。"
              },
              {
                "id": "Q963",
                "date": "2023-08-18",
                "question": "自分のリーダーの体力が5、自分の場に『高垣楓』と『ルシフェル』がいる状況でエンドフェイズを迎えました。この場合、誘発したそれぞれの能力を『高垣楓』の能力から解決することができますか？",
                "answer": "はい。『高垣楓』の能力から解決することができます。『高垣楓』の能力によって自分のリーダーの体力を+5して1枚引いた後に、『ルシフェル』の能力によって自分のリーダーの体力を+4することができます。"
              },
              {
                "id": "Q962",
                "date": "2023-08-18",
                "question": "自分のリーダーの体力が5以下の状態でなくても、自分のエンドフェイズが来たとき、1枚引くことができますか？",
                "answer": "いいえ。1枚引くことができません。自分のリーダーの体力が5以下の状態でない場合、それ以降の効果は働きません。"
              }
            ],
