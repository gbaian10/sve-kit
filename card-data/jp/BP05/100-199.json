    {
      "card_no": "BP05-105",
      "documents": {
        "documents-4e55b4930a993a01": {
          "region": "jp",
          "record": {
            "number": "BP05-105",
            "faces": [
              {
                "name": "飢餓の絶傑・ギルネリーゼ",
                "card_class": "ニュートラル",
                "card_type": "フォロワー",
                "traits": [
                  "絶傑"
                ],
                "rarity": "LG",
                "product": "ブースターパック第5弾「永劫なる絶傑」",
                "title": null,
                "cost": "4",
                "power": "3",
                "hp": "5",
                "text": "【ドレイン】\n自分が{ニュートラル}カードをプレイしたとき、相手のリーダーすべてに1ダメージ。\n{ファンファーレ}{コスト3}：自分のデッキから『飢餓の使徒』1枚と『飢餓の輝き』1枚を探し、EXエリアに置く。\n{ファンファーレ}自分と相手のPP最大値が10なら、3枚引く。",
                "sections": [],
                "flavor": null,
                "illustrator": "香川太郎",
                "image": "/wordpress/wp-content/images/cardlist/BP05/bp05-105.png",
                "trait_raw": "絶傑"
              }
            ],
            "release_date": "2023-04-28",
            "errata_url": null,
            "notes": [],
            "qa": [
              {
                "id": "Q768",
                "date": "2023-04-21",
                "question": "EXエリアから『飢餓の使徒』をプレイした場合、『飢餓の絶傑・ギルネリーゼ』の「自分が《ニュートラル》カードをプレイしたとき、～」は誘発しますか？",
                "answer": "はい。誘発します。\n手札やEXエリアや墓場など、あらゆる領域からのカードのプレイであれば、それがトークンであるか否かに関係なく、カードのプレイを満たします。\nただし、『飢餓の使徒』の進化など、フォロワーの進化はカードのプレイに含みません。"
              },
              {
                "id": "Q767",
                "date": "2023-04-21",
                "question": "『飢餓の絶傑・ギルネリーゼ』の「自分が《ニュートラル》カードをプレイしたとき、～」という能力は、この能力を持つ『飢餓の絶傑・ギルネリーゼ』自身をプレイした場合でも誘発しますか？",
                "answer": "いいえ。誘発しません。『飢餓の絶傑・ギルネリーゼ』をプレイしたとき、その『飢餓の絶傑・ギルネリーゼ』は場におらず、その能力は有効ではありません。"
              },
              {
                "id": "Q766",
                "date": "2023-04-21",
                "question": "『飢餓の絶傑・ギルネリーゼ』のような《ファンファーレ》能力を2つ持つフォロワーを場に出した場合、誘発した2つの《ファンファーレ》能力はどちらから解決しますか？",
                "answer": "好きな順で解決することができます。"
              },
              {
                "id": "Q765",
                "date": "2023-04-21",
                "question": "自分の場に『飢餓の絶傑・ギルネリーゼ』がいる状態で『死の祝福』をプレイし『ルシフェル』を場に出した場合、このフォロワーの「自分が《ニュートラル》カードをプレイしたとき」の能力は誘発しますか？",
                "answer": "いいえ。《ニュートラル》カードをプレイしていないため、能力は誘発しません。『死の祝福』のような、能力によって場に出るものは、カードのプレイではありません。"
              },
              {
                "id": "Q764",
                "date": "2023-04-21",
                "question": "自分のデッキに『飢餓の輝き』がない場合、『飢餓の絶傑・ギルネリーゼ』の《ファンファーレ》能力でデッキから『飢餓の使徒』のみを探し、EXエリアに置くことはできますか？",
                "answer": "はい。可能です。また、『飢餓の輝き』がデッキの中にある場合でも見つけない選択をすることができます。"
              },
              {
                "id": "Q763",
                "date": "2023-04-21",
                "question": "『飢餓の絶傑・ギルネリーゼ』の「自分が《ニュートラル》カードをプレイしたとき」の能力で相手のリーダーに1ダメージを与えたとき、【ドレイン】の効果で自分のリーダーは体力+1しますか？",
                "answer": "いいえ。自分のリーダーの体力を+1しません。【ドレイン】は、攻撃によるダメージを与えたときに、自分のリーダーの体力をそのダメージ数と同じ値増加する能力です。"
              }
            ],
