    {
      "card_no": "BP13-T02",
      "documents": {
        "documents-b21a808c172eecd7": {
          "region": "jp",
          "record": {
            "number": "BP13-T02",
            "faces": [
              {
                "name": "フェイタルバーン",
                "card_class": "ウィッチ",
                "card_type": "スペル・トークン",
                "traits": [
                  "魔法使い",
                  "学院",
                  "プリンセス",
                  "キラー"
                ],
                "rarity": "-",
                "product": "ブースターパック第13弾「暗黒降誕」",
                "title": null,
                "cost": "1",
                "power": "-",
                "hp": "-",
                "text": "下記から1つチョイスする。【1】相手の場のフォロワー1体を選ぶ。それに4ダメージ。【2】相手の場のフォロワー2体を選ぶ。自分の墓場の学院・カードが15枚以上なら、それに4ダメージ。",
                "sections": [],
                "flavor": null,
                "illustrator": "こーやふ",
                "image": "/wordpress/wp-content/images/cardlist/BP13/bp13-t02.png",
                "trait_raw": "魔法使い・学院・プリンセス・キラー"
              }
            ],
            "release_date": "2024-12-13",
            "errata_url": null,
            "notes": [],
            "qa": [
              {
                "id": "Q1811",
                "date": "2024-12-13",
                "question": "自分の墓場の学院・カードが14枚以下の場合、【2】をチョイスし、何も起こらないことを選択できますか？",
                "answer": "はい。【2】をチョイスすることができます。\nその場合、「自分の墓場の学院・カードが15枚以上なら、」を満たさないため、何も起こりません。"
              },
              {
                "id": "Q1810",
                "date": "2024-12-13",
                "question": "相手の場のフォロワーが1体のみの場合、【2】をチョイスし、何も起こらないことを選択できますか？",
                "answer": "いいえ。適切な目標を選ぶことができない場合、【2】をチョイスすることができず、【1】をチョイスする必要があります。"
              }
            ],
