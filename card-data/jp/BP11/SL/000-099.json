            "faces": [
              {
                "name": "ストレイホロウ・イルガンノ",
                "card_class": "ナイトメア",
                "card_type": "フォロワー",
                "traits": [
                  "荒野",
                  "死者",
                  "魔界"
                ],
                "rarity": "SL",
                "product": "ブースターパック第11弾「宿命の弾丸」",
                "title": null,
                "cost": "1",
                "power": "1",
                "hp": "1",
                "text": "{ファンファーレ}自分の墓場の元のコスト3以下の荒野・フォロワー1枚を選ぶ。【ネクロチャージ_10】それを場に出してよい。そうしたなら、これは消滅する。\n{ラストワード}これをEXエリアに置く。自分のデッキの上1枚を墓場に置く。",
                "sections": [],
                "flavor": null,
                "illustrator": "irua",
                "image": "/wordpress/wp-content/images/cardlist/BP11/bp11-sl15.png",
                "trait_raw": "荒野・死者・魔界"
              }
            ],
            "release_date": "2024-08-23",
            "errata_url": null,
            "notes": [],
            "qa": [
              {
                "id": "Q1548",
                "date": "2024-08-20",
                "question": "自分の墓場が10枚以上の状況で、『ネフティス』の《ファンファーレ》能力をプレイし、『ストレイホロウ・イルガンノ』を場に出して破壊しました。この場合、『ストレイホロウ・イルガンノ』の《ファンファーレ》能力で、墓場に置かれたこの『ストレイホロウ・イルガンノ』自身を選び、場に出すことができますか？",
                "answer": "はい。《ファンファーレ》能力を解決する際に、その『ストレイホロウ・イルガンノ』は墓場に置かれているため、場に出すことができます。その場合、墓場から場に出た『ストレイホロウ・イルガンノ』は消滅しません。\nまた、《ファンファーレ》能力によって、その『ストレイホロウ・イルガンノ』を選び場に出した後、《ラストワード》能力を解決した場合、場の『ストレイホロウ・イルガンノ』はEXエリアに置かれません。"
              },
              {
                "id": "Q1547",
                "date": "2024-08-20",
                "question": "自分の墓場が10枚以上の状況で、『ネフティス』の《ファンファーレ》能力をプレイし、『ストレイホロウ・イルガンノ』を場に出して破壊しました。この状況で『ストレイホロウ・イルガンノ』の《ファンファーレ》能力を解決し、自分の墓場の元のコスト3以下の荒野・フォロワーを場に出した場合、この『ストレイホロウ・イルガンノ』は消滅しますか？",
                "answer": "いいえ。《ファンファーレ》能力を解決する際に、すでに場にいないため、その『ストレイホロウ・イルガンノ』は消滅しません。"
              },
              {
                "id": "Q1546",
                "date": "2024-08-20",
                "question": "『ネフティス』の《ファンファーレ》能力によって、『ストレイホロウ・イルガンノ』を場に出して破壊した場合、《ラストワード》能力を先に解決することができますか？",
                "answer": "はい。誘発して待機状態になっている《ファンファーレ》能力と《ラストワード》能力は任意の順番で解決できます。"
              },
              {
                "id": "Q1545",
                "date": "2024-08-20",
                "question": "自分のEXエリアが上限枚数の状況で、このフォロワーが場から墓場に置かれた場合、《ラストワード》能力の処理はどうなりますか？",
                "answer": "EXエリアに置くことができないので、墓場から移動しません。"
              }
            ],
