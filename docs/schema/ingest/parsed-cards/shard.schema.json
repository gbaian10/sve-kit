        "href": {
          "title": "Href",
          "type": "string"
        }
      },
      "required": [
        "label",
        "href"
      ],
      "title": "RelatedHint",
      "type": "object",
      "additionalProperties": false
    },
    "RelatedLink": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "href_raw": {
          "minLength": 1,
