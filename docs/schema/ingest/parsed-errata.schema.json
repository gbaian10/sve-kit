{
  "$defs": {
    "Block": {
      "additionalProperties": false,
      "properties": {
        "ordinal": {
          "title": "Ordinal",
          "type": "integer"
        },
        "context": {
          "items": {
            "type": "string"
          },
          "title": "Context",
          "type": "array"
        },
        "before": {
          "title": "Before",
          "type": "string"
        },
        "after": {
          "title": "After",
          "type": "string"
        },
        "raw_before": {
          "$ref": "#/$defs/Slice"
        },
        "raw_after": {
          "$ref": "#/$defs/Slice"
        }
      },
      "required": [
        "ordinal",
        "context",
        "before",
        "after",
        "raw_before",
        "raw_after"
      ],
      "title": "Block",
      "type": "object"
    },
    "Change": {
      "additionalProperties": false,
      "properties": {
        "card_no": {
          "minLength": 1,
          "title": "Card No",
          "type": "string"
        },
        "face_id": {
          "minLength": 1,
          "title": "Face Id",
          "type": "string"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "before_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before Value"
        },
        "after_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "After Value"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "scope": {
          "enum": [
            "fragment",
            "field"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "card_no",
        "face_id",
        "field",
        "before_value",
        "after_value",
        "locator",
        "scope"
      ],
      "title": "Change",
      "type": "object"
    },
    "ErrataPrinting": {
      "additionalProperties": false,
      "properties": {
        "card_no": {
          "minLength": 1,
          "title": "Card No",
          "type": "string"
        },
        "scope": {
          "default": "listed",
          "enum": [
            "listed",
            "confirmed_applies"
          ],
          "title": "Scope",
          "type": "string"
        },
        "decision_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Id"
        }
      },
      "required": [
        "card_no"
      ],
      "title": "ErrataPrinting",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^src:v1:[0-9a-f]{64}(?![\\s\\S])",
          "title": "Id",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])",
          "title": "Sha256",
          "type": "string"
        },
        "fetched_at": {
          "pattern": "^^(?:(?!0000)[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$(?![\\s\\S])$",
          "title": "Fetched At",
          "type": "string"
        },
        "etag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Etag"
        },
        "last_modified": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Modified"
        },
        "parser_version": {
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "batch_id": {
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])",
          "title": "Batch Id",
          "type": "string"
        },
        "descriptor_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])",
          "title": "Descriptor Sha256",
          "type": "string"
        },
        "first_receipt_id": {
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])",
          "title": "First Receipt Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "url",
        "sha256",
        "fetched_at",
        "etag",
        "last_modified",
        "parser_version",
        "batch_id",
        "descriptor_sha256",
        "first_receipt_id"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Notice": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/Evidence"
        },
        "region": {
          "enum": [
            "jp",
            "en"
          ],
          "title": "Region",
          "type": "string"
        },
        "announced_on": {
          "anyOf": [
            {
              "pattern": "^^(?:(?!0000)[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)$(?![\\s\\S])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Announced On"
        },
        "effective_on": {
          "anyOf": [
            {
              "pattern": "^^(?:(?!0000)[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)$(?![\\s\\S])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effective On"
        },
        "date_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Date Raw"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "exchange_offered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exchange Offered"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/Change"
          },
          "title": "Changes",
          "type": "array"
        },
        "printings": {
          "items": {
            "$ref": "#/$defs/ErrataPrinting"
          },
          "title": "Printings",
          "type": "array"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "title": "Blocks",
          "type": "array"
        },
        "review_note": {
          "minLength": 1,
          "title": "Review Note",
          "type": "string"
        }
      },
      "required": [
        "source",
        "region",
        "announced_on",
        "effective_on",
        "date_raw",
        "reason",
        "exchange_offered",
        "changes",
        "printings",
        "blocks",
        "review_note"
      ],
      "title": "Notice",
      "type": "object"
    },
    "Slice": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "title": "End",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "sha256"
      ],
      "title": "Slice",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": 1,
      "title": "Format",
      "type": "integer"
    },
    "notices": {
      "items": {
        "$ref": "#/$defs/Notice"
      },
      "title": "Notices",
      "type": "array"
    }
  },
  "required": [
    "format",
    "notices"
  ],
  "title": "Notices",
  "type": "object"
}
