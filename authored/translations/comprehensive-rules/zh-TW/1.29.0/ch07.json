  "format": 1,
  "kind": "comprehensive-rules-translation",
  "version": "1.29.0",
  "language": "zh-TW",
  "entries": {
    "7": {
      "title": "遊戲進行",
      "source_sha256": "104f91144765b835d76b7c11edd8545fab97a547e789f1b676bf9c8a1f120628"
    },
    "7.1": {
      "title": "概要",
      "source_sha256": "1420552cea6d1b22adfdf818db9078179545caa73907f90aa0f9ce0cd905008b"
    },
    "7.1.1": {
      "text": "遊戲以重複進行稱為「回合」的步驟來推進。在某個回合中，其中一名玩家為回合玩家，其餘玩家為非回合玩家。",
      "source_sha256": "c249da340b6bda9c52b192cb22164710e4307e392b7754049c295e6a16cc963c"
    },
    "7.1.2": {
      "text": "回合玩家依7.2至7.4所示的順序執行各階段。",
      "source_sha256": "067ddc19c813515a887e7df9f3b3e55147442e91e866dc31456550adb8f89914"
    },
    "7.2": {
      "title": "開始階段",
      "source_sha256": "0ab4badaf3404677d8e58a37027f81fc0875ec24e4463433208c005822b33f2c"
    },
    "7.2.1": {
      "text": "回合玩家自身的PP最大值未滿10時，使PP最大值＋1。",
      "source_sha256": "2ddb424cba7b0980ca1aed9d541b78c29553ac6b0b89188916f2859a7549e3b2"
    },
    "7.2.2": {
      "text": "回合玩家使自身的PP變為與自身的PP最大值相等的值。",
      "source_sha256": "1af0d99eff4eba00530a1224c635959ecfec541155ce1a75c4e0865052d14b0a"
    },
    "7.2.3": {
      "text": "回合玩家將自身戰場上的全部卡片重置。",
      "source_sha256": "e912fbc63324de2256747a639d1565f32d93959c39f4e7147b6233af43b29b24"
    },
    "7.2.4": {
      "text": "回合玩家抽1張卡片。",
      "source_sha256": "7e4a06c424f6a0dcdbb599bbd0598677c0197127c822fbc7aa88b5f23ee662f2"
    },
    "7.2.4.1": {
      "text": "先攻玩家在自身最初的回合不抽卡片。",
      "source_sha256": "ed1b324dc1d4965039c6c94f95a19dea639998338cba10afa522e4acb2ed0e10"
    },
    "7.2.5": {
      "text": "發生檢查時點。在此檢查時點應進行的處理全部結束後，進入主要階段。",
      "source_sha256": "812763e0e0a415ad0ff246f6f614a96aef73065fa459b523baaf605f30c45911"
    },
    "7.3": {
      "title": "主要階段",
      "source_sha256": "310538344492e3660a5155a581a4d9752376b05b321b96886ddd8a0d10ac2b6d"
    },
    "7.3.1": {
      "text": "發生「主要階段到來時」的觸發條件。",
      "source_sha256": "8ea117a8460b813c8607075ff95170c558b1162f3194361df54eb5f2e1b86065"
    },
    "7.3.2": {
      "text": "發生檢查時點。",
      "source_sha256": "3d39a9c0e8e25721402327ae4ae57ebe995b5d538cd8725cd30055df94e6ca13"
    },
    "7.3.3": {
      "text": "回合玩家執行下列其中一項。\n* 使用1張手牌或EX區的卡片（8.2）。\n* 使用1個自己為操控者的卡片的起動能力（8.3）。\n* 以1個自己為操控者的從者進行攻擊（8.4）。\n* 結束主要階段。",
      "source_sha256": "0e687bf5391880fcb143a184a692fc104a808b70e9295172f9a19da5263716e7"
    },
    "7.3.3.1": {
      "text": "回合玩家因某個效果而被強制在主要階段中滿足特定條件，且尚未滿足該條件時，不能選擇結束主要階段。",
      "examples": [
        "例：適用著「這個從者須在可能的情況下每回合攻擊1次」效果的從者，其操控者為回合玩家，且這個從者可以攻擊卻尚未攻擊時，回合玩家不能結束主要階段。"
      ],
      "source_sha256": "8a107c8cdefda8c54e37c0569e5e6409e4301b34ed9dd8ff93a88ec2a1a96175"
    },
    "7.3.4": {
      "text": "在7.3.3選擇結束主要階段時，進入結束階段。選擇其他項目時，發生檢查時點，之後再次回到7.3.3。",
      "source_sha256": "ba847ede309018f654d72d63ecc59ba2a7128f931d20e28a68092cc11cb405e4"
    },
    "7.4": {
      "title": "結束階段",
      "source_sha256": "6a86ff6b40fb2a8adfcdfdb628d76c276e5302e5f4e08753c9204041d65073b6"
    },
    "7.4.1": {
      "text": "發生「結束階段到來時」所示的觸發條件。",
      "source_sha256": "38362cc40640b60c8b9ab3e193202bbb2845bb7c6ace0fe507902b5ec6344ac7"
    },
    "7.4.2": {
      "text": "發生檢查時點。",
      "source_sha256": "3d39a9c0e8e25721402327ae4ae57ebe995b5d538cd8725cd30055df94e6ca13"
    },
    "7.4.3": {
      "text": "回合玩家從自己的從者中選擇任意數量具有【守護】者，將其橫置。",
      "source_sha256": "72804d3f4f3132c6958fb35217f16a5e2fdedefd555c6c81a0910d1efc5ad554"
    },
    "7.4.4": {
      "text": "發生檢查時點。",
      "source_sha256": "3d39a9c0e8e25721402327ae4ae57ebe995b5d538cd8725cd30055df94e6ca13"
    },
    "7.4.5": {
      "text": "非回合玩家執行下列其中一項。\n* 使用1張手牌或EX區中具有【Quick】的卡片（10.6）。\n* 使用1個具有【Quick】的起動能力。\n* 什麼都不做。",
      "source_sha256": "05d77ddcbd14f4e4721041181acd6221ff8992e61e41f6aec4e2888103608d26"
    },
    "7.4.6": {
      "text": "在7.4.5使用了卡片或能力時，發生檢查時點，之後再次回到7.4.5。",
      "source_sha256": "c1f7a5d6cb684cfe0eb3c7bb635256e923c6d880283e61add36051d514d2855b"
    },
    "7.4.7": {
      "text": "回合玩家自身手牌的卡片張數超過手牌上限時，捨棄張數等同於超過部分的卡片。因此捨棄了卡片時，之後發生檢查時點，再次回到7.4.7。",
      "source_sha256": "f4b8cf8064b3ef43bbe54b7962bddf12e33f1c01796497c4433e0df94638721d"
    },
    "7.4.8": {
      "text": "全部以「到回合結束為止」為期限的效果與以「該回合中」為期限的效果會被移除。",
      "source_sha256": "ad0cbe725358c00e22881edf8318213b239ea178579c9e74357a121d67b093fa"
    },
    "7.4.9": {
      "text": "結束本回合。之後，以本回合的非回合玩家為回合玩家，開始新的回合。",
      "source_sha256": "ce64b5c493288373d54ecd117e42fd1a6ec42b544f29aabc8f4058bc030d991b"
    }
  }
}
