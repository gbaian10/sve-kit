  "version": "1.29.0",
  "language": "zh-TW",
  "entries": {
    "3": {
      "title": "玩家相關資訊",
      "source_sha256": "92810a59451fdf598ec7de093fac979d67aadcd9b2ba59771a1409b3d32e7c47"
    },
    "3.1": {
      "title": "所有者與操控者",
      "source_sha256": "5caa08483d0f7d74d876c15043b755bf629915b0ed72b95a10e8314b212d6fed"
    },
    "3.1.1": {
      "text": "所有者是指卡片在實體上的擁有者。某張卡片的所有者，是指將該卡片放入牌堆並開始遊戲的玩家。遊戲結束的階段，各玩家取回自己為所有者的全部卡片。",
      "source_sha256": "8d44f1feb20f107d7e7e62593b13f61b0f82759f0e16ed03f9961638d520c264"
    },
    "3.1.2": {
      "text": "操控者是指目前正在運用卡片、能力或效果等的玩家。放置在某個區域的卡片的操控者，是指該區域所屬的玩家。",
      "source_sha256": "63d5cb7bfc088bd67d4f29c365c33a86e74c08b6733203d8ff3a24efaae5fe11"
    },
    "3.1.2.1": {
      "text": "永續能力的操控者，是指具有該能力的卡片的操控者，或產生該能力的效果的操控者。",
      "source_sha256": "4bc2124e593eda801023a8f4161370796f0c41b2327b9d7da705232a734d6351"
    },
    "3.1.2.2": {
      "text": "起動能力的操控者，是指使用該能力的玩家。",
      "source_sha256": "1c6842e3aee830fc5c5fbc31ed4e6ff12daecb00a6d24e36347fc0bfa2653cc8"
    },
    "3.1.2.3": {
      "text": "自動能力的操控者，是指具有該能力的卡片的操控者，或產生該能力的效果的操控者。",
      "source_sha256": "f2c51b97268c51244f8792511a9b470b8668a9182d1bceb7fcbdbc526f158e03"
    },
    "3.1.2.4": {
      "text": "效果的操控者，是指產生該效果的能力的操控者。",
      "source_sha256": "450b1d7017d9078a3bc05c2a23c1a2ca9a91d0580ff7aaf7b86418799f23341d"
    },
    "3.1.2.4.1": {
      "text": "某個效果未特別指定玩家而指示進行某個行動時，由該效果的操控者執行該指示。",
      "source_sha256": "fd3bcd45ed66733786ee4c72d428346655b8fcae1a35e82f1a3fc5d4cd14f8d3"
    },
    "3.2": {
      "title": "PP/EP/SEP",
      "source_sha256": "a78d2524d5ce410835f471ecfdcdb2ae217c6b2bb89264b3521da66f18cde735"
    },
    "3.2.1": {
      "text": "PP（Play Point）、PP最大值與EP（Evolve Point），是各玩家各自具有的數值資訊。",
      "source_sha256": "3843f530513d0759e7fd73bb65dad3bd583921c3ee857af12c16dae1cc32f3bd"
    },
    "3.2.2": {
      "text": "PP是玩家為了使用卡片或進行進化，作為消費而耗用的數值（10.4.3）。",
      "source_sha256": "b4655652686ef4e2295e90a7e2678be83450a6b32d01e7a9c99ded16b9b68a4f"
    },
    "3.2.3": {
      "text": "PP最大值是玩家在回合的最初取得的PP的值。",
      "source_sha256": "efba29cb151a3054209962ac8eff97c419a104cd26e07e298628148272ca9dd8"
    },
    "3.2.4": {
      "text": "PP與PP最大值有下限與上限。遊戲中PP或PP最大值高於該上限或低於該下限時，其不會變為超出的值，而是變為上限或下限的值。",
      "source_sha256": "269592c42b83c6bfc3df71c6389fdce8fdc664169fa391fa7f200ca2fb8ea54d"
    },
    "3.2.4.1": {
      "text": "PP最大值的下限為0，上限為10。",
      "source_sha256": "fda66fc05758660f9453538ce7855824f4aef8cc7f13624e5840b290bcb07116"
    },
    "3.2.4.2": {
      "text": "PP的下限為0，上限為目前的PP最大值。",
      "source_sha256": "1e5c2b0086cd33303de3df619b07fcd328a355b87355c46f555ca928e5f39d97"
    },
    "3.2.5": {
      "text": "EP是玩家使用進化能力（12.1.2.1）時，可以代替PP耗用的數值（12.2.2）。",
      "source_sha256": "f2601a0f635a8a7b1287c1766f7a45f3b485b91d469341d8b7fe835ebc5d9f17"
    },
    "3.2.5.1": {
      "text": "EP的下限為0。",
      "source_sha256": "7946543dda6ce5b759d5134bda9cbb671672163d7f47ab7b53bee711b50f8d73"
    },
    "3.2.6": {
      "text": "SEP是玩家進行超進化（12.2.4）時耗用的數值。",
      "source_sha256": "2261c151e9d4c293cf4056f9c933170ed1597faa420cf45e08ef62d7c65ee929"
    },
    "3.2.6.1": {
      "text": "SEP的下限為0。",
      "source_sha256": "63b112b649f9cf3803eb13b0f6b9b3e11e1404209b57b53f01b2331b06da7d0d"
    },
    "3.3": {
      "title": "經過回合數",
      "source_sha256": "ecd345f9235c4ff1fcbb969d49eb22584d788d61eb45e477e81e38b4b3a8e571"
    },
    "3.3.1": {
      "text": "經過回合數是各玩家各自具有的數值資訊。",
      "source_sha256": "530ef07ec247a19d243ecd765a7903dc321286dd5ad151fe39af9f303a5feb2a"
    },
    "3.3.2": {
      "text": "參照某名玩家的經過回合數時，參照該玩家作為回合玩家，在該回合首次開始開始階段（7.2）的次數。",
      "source_sha256": "e620f98f29b18175fd6173603b00b6ba5dac55c936152c58277f7f5f1ce09f6f"
    },
    "3.3.2.1": {
      "text": "某名玩家跳過了回合（5.26）時，該回合不計入經過回合數。",
      "source_sha256": "cfa8847ac41bc25eb24728c27d0f02d7c6c4d5b288ddd77fa002e91c7b3c4f98"
    },
    "3.3.2.2": {
      "text": "某名玩家進行了額外回合（5.28）時，該回合計入經過回合數。",
      "source_sha256": "6141ed180dab3b3f6438c3e8aaeb8bd8b0cf97f54f7ada2c41770d832fb5c0e8"
    }
  }
}
