  "language": "zh-TW",
  "entries": {
    "15": {
      "title": "其他",
      "source_sha256": "7dc86433a108898f0bb078cfe6a65d544081fa6f12495facb1515c5e9cc48875"
    },
    "15.1": {
      "title": "指示物",
      "source_sha256": "a9f068afef0a2fbc4959168f87c3cb65667a0900e7aa39416d5e45e3ee1f01d8"
    },
    "15.1.1": {
      "text": "遊戲中，有時會在卡片上放置或移除特定的指示物。",
      "source_sha256": "dd74a56aa4912de5a2655ed855fbe63ae8d4497c41b1ad6306e3c10e64ea2254"
    },
    "15.1.2": {
      "text": "指示物具有名稱。",
      "source_sha256": "aff341dda670f476a5f6c07e60a41f70ff5cfb7e49058c653c6516261172e0c7"
    },
    "15.1.2.1": {
      "text": "「（名稱）指示物」是指以該（名稱）為名稱的指示物。",
      "source_sha256": "dbd093509e3ec69606a47f36cf57e57d4972b5fdc86375d650335c6a5b3a7fa7"
    },
    "15.1.2.2": {
      "text": "相同名稱的指示物，不論該指示物被放置的原因為何，視為彼此相同的指示物。",
      "source_sha256": "dc0903b5bcc3d2ecf029032edb2eb684421044e38cd91034dba925926891ce79"
    },
    "15.1.3": {
      "text": "在卡片上放置指示物時，在該卡片上放置可明確辨識的物品。",
      "source_sha256": "bcce114fe5c9f6c79849ae4141cbdfe1f2564e2147679c7750b1639932481b3c"
    },
    "15.1.4": {
      "text": "從卡片移除指示物時，移除該卡片上所指定的指示物。",
      "source_sha256": "c0c31f032f9035cf1c44aa599a9c63bfd0bfc96902917e2d7609494db57b482d"
    },
    "15.2": {
      "title": "無限循環",
      "source_sha256": "22473f582f07c11d6f0c6a49e32a4f69aa0cce340f947cd2efa10999c5bd61ec"
    },
    "15.2.1": {
      "text": "進行某個處理時，可能會出現可以無限持續執行某個行動，或不得不無限執行某個行動的情形。這稱為無限循環，此時依下列規定。",
      "source_sha256": "ae38bd6bcef93b7b855614f9330cc6d4acd6b7dd4a7d21e7d0f5fd0a6cbfd3fc"
    },
    "15.2.1.1": {
      "text": "回合玩家出示該循環行動中實際進行的一連串行動，之後出示執行該行動的次數。之後，非回合玩家可以選擇同意執行該次數的行動，或宣告在該循環行動內的特定時點進行不包含在該行動中的行動，藉此使其執行較少次數的行動。之後，依該選擇執行這些行動。",
      "source_sha256": "696b6e7914f984442e6f792adcf14ec98ed98e43ea83d90b504b54fe42244600"
    },
    "15.2.1.2": {
      "text": "回合玩家進行某個行動，之後發生遊戲完全相同的狀態時，回合玩家不能再次進行當時所進行的行動。",
      "source_sha256": "ae161eea1b30f9cf1e753c20a7df54f56ca142fb37836c4e157f15dfba8956b8"
    },
    "15.2.1.3": {
      "text": "因某種原因，任一玩家都沒有方法停止該無限循環時，遊戲以平手結束。",
      "source_sha256": "bdb3f3c58f8430cd70aa79eb6d643da42647877bc810974422ad01f4bc740048"
    }
  }
}
