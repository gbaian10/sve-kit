{
  "format": 1,
  "kind": "comprehensive-rules-translation",
  "version": "1.28.0",
  "language": "zh-TW",
  "entries": {
    "11": {
      "title": "規則處理",
      "source_sha256": "7fdf22541fb8605c5e364e922b88b6bb57b169998e5c1fdc01cda54f31f58922"
    },
    "11.1": {
      "title": "規則處理的基本",
      "source_sha256": "68397ee6efe148fd8d5fed6da3dcbee38092ec1f7e48d101c48f1380b0af3d82"
    },
    "11.1.1": {
      "text": "規則處理是指在遊戲中發生了特定的事件，或特定的事件正在發生時，依規則自動執行的處理的總稱。",
      "source_sha256": "e76bcd6e1ddef8206a23491535b0cdd5abefa887dd9cef618929d8e08af38ead"
    },
    "11.1.2": {
      "text": "規則處理只在檢查時點確認是否滿足條件，滿足時執行。即使在其他行動的執行中滿足了條件，若在檢查時點的階段不滿足該條件，則不進行該規則處理。",
      "source_sha256": "8f947223deff4eaea1333afe2528d3152ed1c4701bee2603f4f901b570e27733"
    },
    "11.1.3": {
      "text": "同時被要求執行多個規則處理時，將其全部同時執行。",
      "source_sha256": "2dd7f320d2ed59ece6286ffa4bcca01ad1bd19dc5050c8ff6be09f9242d0e6cd"
    },
    "11.2": {
      "title": "敗北處理",
      "source_sha256": "900647aad1dbddd70ece419d6a097a643aeb94cadd5e427032f948df3f6a6e6c"
    },
    "11.2.1": {
      "text": "有自身的主戰者的生命值為0以下的玩家時，該玩家在本場遊戲中敗北。",
      "source_sha256": "6b0e0f4e90a4b60ba3755adf9ad4e1612309a616397e21a789264c4fd11febc4"
    },
    "11.2.2": {
      "text": "在前一次規則處理之後，任一玩家被要求抽卡片，而當時牌堆放置區沒有卡片時，該玩家在本場遊戲中敗北。",
      "source_sha256": "7f54dccacb247b4b69930af550b98408de3ce85c550f482094874ed098d51abd"
    },
    "11.3": {
      "title": "從者破壞處理",
      "source_sha256": "821004711f607bcb8cb930c3b1a2e457e70c05bdd808f07982dc42dfe44b1bc0"
    },
    "11.3.1": {
      "text": "某個從者的生命值為0以下時，該從者被破壞。",
      "source_sha256": "48dba34e1d8de615d6cad88561203accbef36db33e3e3b66b31a624aa0009d86"
    },
    "11.3.2": {
      "text": "在前一次規則處理之後，任一從者曾與具有必殺（12.14）的從者交戰時，該從者被破壞。",
      "source_sha256": "9cf387af0fc54fb4f4ab245e369cba07ba61eee3574622cd9e36c89088e348c6"
    },
    "11.3.2.1": {
      "text": "某個效果參照「被能力破壞」時，依11.3.2進行的破壞視為被必殺能力破壞。",
      "source_sha256": "4472a20381c194bbec42b21d3c3c9f20d8c978bc6f73a3f2e13ad314707c37bb"
    },
    "11.4": {
      "title": "戰場超過處理",
      "source_sha256": "cd9831d229c843d66452e4020c9c5d2e523ca6624116e398b7a4626c2020d92d"
    },
    "11.4.1": {
      "text": "任一戰場上存在超過該戰場上限的張數的卡片時，從中選擇張數等同於該戰場上限的卡片，將其餘卡片移動到所有者的墓場。",
      "source_sha256": "2d337eb8e30b9efde66f4dddf85edf901e4aa26ffe3aab8e615e4411b7c6f62e"
    },
    "11.5": {
      "title": "EX區超過處理",
      "source_sha256": "10eec4bfecbefb719e31caecdcb7e221e9b91057f6545addc8eaf979ef476242"
    },
    "11.5.1": {
      "text": "任一EX區中存在超過該EX區上限的張數的卡片時，從中選擇張數等同於該EX區上限的卡片，將其餘卡片移動到所有者的墓場。",
      "source_sha256": "86acf5c06c8de74fe6cbfa2121063521b4facd197faa5f48f788a34ab0a7f4fd"
    },
    "11.6": {
      "title": "不合法進化處理",
      "source_sha256": "ea091adb35348cddcde08a9095d0473218a52a1137422d572d85923199e25f70"
    },
    "11.6.1": {
      "text": "進化區的卡片未與戰場上的任何卡片建立關聯時，將該卡片以正面朝上移動到進化牌堆放置區。",
      "source_sha256": "9c113671e3158d1d26877c94daa7dc769dfa3f4b35c4bc1cf78f8a5050d9af05"
    },
    "11.6.2": {
      "text": "戰場上的1張卡片與多張進化區的卡片有關聯時，該戰場上的卡片的操控者從其中最晚建立關聯的卡片中選擇1張，該戰場上的卡片與所選卡片以外的進化區卡片之間的關聯會失去。",
      "source_sha256": "78c113960bc56b742636d50e29a68ce1c452939e33fde53c9243b29b84eae3de"
    },
    "11.6.3": {
      "text": "1張進化區的卡片與多張戰場上的卡片有關聯時，該進化區的卡片的操控者從其中最晚建立關聯的卡片中選擇1張，該進化區的卡片與所選卡片以外的戰場上的卡片之間的關聯會失去。",
      "source_sha256": "0075b2762dd165fb6779bb0164a3705b7e63085fa10aa445dde7a9bd232f1e9c"
    },
    "11.7": {
      "title": "蓄積處理",
      "source_sha256": "89b8742c36af2fc5d107c664932887f1daf93b9df6e31bf6bf12b439ce36bed7"
    },
    "11.7.1": {
      "text": "戰場上任一具有蓄積能力（13.3.2）的卡片上沒有放置蓄積指示物時，將該卡片移動到所有者的墓場。",
      "source_sha256": "5978c61f23ab4e600df0b72943dd60fc58ca126da6c46f40c8f91a8f2db9d215"
    },
    "11.8": {
      "title": "不合法參賽處理",
      "source_sha256": "82d79e6e6a31deb34bce195f513fcc57d5f3ec337b5ce5e6e0b5ca4adf750d92"
    },
    "11.8.1": {
      "text": "參賽區的卡片未與戰場上的任何卡片建立關聯時，將該卡片以正面朝上移動到進化牌堆放置區。",
      "source_sha256": "7d3f254bc089a19cfa95fb92221c917c1dac180588f92bed1559a5124a3e2199"
    },
    "11.9": {
      "title": "PP超過處理",
      "source_sha256": "be5502750e825653cbfe17f40ef6da4bd3c9b81fc6d21f53b24a5bf6293683bd"
    },
    "11.9.1": {
      "text": "某名玩家目前的PP的值超過該玩家的PP最大值時，該玩家的PP變為該PP最大值。",
      "source_sha256": "6a4efbcaaa66cb2e7d49737bbb43cf5600a344bc41848c5ced41e3b02acca676"
    },
    "11.10": {
      "title": "不合法驅動點數處理",
      "source_sha256": "41b4f4d0919ec3554037d72213a7523b131d25955938d342ed193250ded0ee2e"
    },
    "11.10.1": {
      "text": "驅動區的『驅動點數』未與戰場上的任何卡片建立關聯時，將該卡片以正面朝上移動到進化牌堆放置區。",
      "source_sha256": "1add46136855c81c289ead4304ac42a2462c21173fb7d8934eeafdf3b2c53fd0"
    },
    "11.11": {
      "title": "不合法裝備處理",
      "source_sha256": "5a4c183a40057a96efb8d38446f1a5750c1572a7b5866def51a387a8c8564f81"
    },
    "11.11.1": {
      "text": "裝備區的Token未與戰場上的任何卡片建立關聯時，將該Token消除（9.1.3）。",
      "source_sha256": "a1bb0391ff41a0fd4972ae2438c548d31d05e7ad0611c87403deea27499040ee"
    },
    "11.11.2": {
      "text": "裝備區的Token的操控者，與和其有關聯的戰場上的卡片的操控者不同時，該Token的操控者變為與其有關聯的戰場上的卡片的操控者。",
      "source_sha256": "23a1fe0b900480a3a767657f7474232b0159d8f86787cff659a27d4359637484"
    }
  }
}
