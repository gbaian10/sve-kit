{
  "format": 1,
  "kind": "comprehensive-rules-translation",
  "version": "1.28.0",
  "language": "zh-TW",
  "entries": {
    "6": {
      "title": "遊戲準備",
      "source_sha256": "54f026197a89d72f35727e00e6fd8670f4fb12790ad31d86d4cb7abf3d14784f"
    },
    "6.1": {
      "title": "卡片的準備",
      "source_sha256": "10442f8d73226c2237a88d368912a46eb4b0d149459540b366a09db7fa430327"
    },
    "6.1.1": {
      "text": "各玩家在遊戲開始前，以自身的卡片準備主戰者卡、主牌堆與進化牌堆。",
      "source_sha256": "a5ea620bd2d30c2f3aa319d80998e9c5b3cab6a6167c963fe34ce323f9d8c64c"
    },
    "6.1.1.1": {
      "text": "主戰者卡只準備1張。",
      "source_sha256": "0788823214788cdf470eb55894fef055e81797f4a3022e2682b3f9f17fc7726f"
    },
    "6.1.1.2": {
      "text": "主牌堆由40張以上、50張以下的卡片構成。主牌堆內不能放入主戰者卡，以及特殊種類為進化、進階或Token的卡片。",
      "source_sha256": "3739553398f2c1aba9ce9d46a2a776763d8a4bdc2d51249629fd6d3cb95c0bca"
    },
    "6.1.1.3": {
      "text": "進化牌堆由0張以上、10張以下的卡片構成。進化牌堆內只能放入特殊種類為進化或進階的卡片。",
      "source_sha256": "6e505d86b9e2e96abc880008eac55cbd350e47b59d089ea9f40d44a6a794db32"
    },
    "6.1.1.4": {
      "text": "相同卡片名稱的卡片，在主牌堆與進化牌堆可以各放入至多3張（共6張）。",
      "source_sha256": "fb694e28e4065002ec949a5e16f00b27f2441209802f6e8e99b79828c747c57c"
    },
    "6.1.1.4.1": {
      "text": "雙面卡（2.15）以其第1面的卡片名稱為基準。",
      "source_sha256": "c68cde7781ff6671430e9ef6fb26bb29b8806a01b40dfa9e83f3c2b0c70b9b59"
    },
    "6.1.1.5": {
      "text": "主戰者卡、主牌堆與進化牌堆的卡片，必須以職業或作品至少其中一方為基準。",
      "source_sha256": "5a36778985f36d89ec0633d2f2d68a4a19d2a044c1c4323da691d02573801b08"
    },
    "6.1.1.5.1": {
      "text": "以職業為基準時，主牌堆與進化牌堆的各卡片的職業，必須全部是與主戰者卡相同的職業或中立。",
      "source_sha256": "0dcf06e14324e111b159c8c8b3ad704a985ac93bd55c2ac335c102a5069feddf"
    },
    "6.1.1.5.2": {
      "text": "以作品為基準時，主戰者卡以及主牌堆與進化牌堆的各卡片，必須全部具有作品名，且全部為相同的作品名。",
      "source_sha256": "c9582ef5cb4480c020c1376e918063261f443f4574dc7ef07889a0bf6041262c"
    },
    "6.1.1.5.2.1": {
      "text": "以部分作品為基準的牌堆構築中，有些具有該作品獨有的構築條件。詳情請參照「14各作品的資訊與關鍵字」的各作品。",
      "source_sha256": "5db5d76f7e9d9ff649ccd6bd1290fa31d85f590c3b7e4a384402dc8e6130c72c"
    },
    "6.1.2": {
      "text": "與牌堆的構築條件有關的永續能力，作為置換上述牌堆構築條件的置換效果適用。遊戲開始以後，該能力變為無效（10.3.2）。",
      "source_sha256": "640b224c6ccfc5eb29202e9705f238f62cb2111767a0b8055148a6b84de0dbf3"
    },
    "6.2": {
      "title": "遊戲前的步驟",
      "source_sha256": "464c1f7c4753d75e68ef72da0b0f7b9da6ce3b1bf85683b6ae24c6c67a65300d"
    },
    "6.2.1": {
      "text": "遊戲開始前，各玩家執行下列步驟。",
      "source_sha256": "f867cad9752744776a314eee3ad2b9f8630a771c5a97eb10f52e532960f9219e"
    },
    "6.2.1.1": {
      "text": "出示本場遊戲所用的自身的主戰者卡、主牌堆與進化牌堆。",
      "source_sha256": "a9886fc077f6a93d64d0e59dd9ff4e992b0f9f3777424a2c7f5d043a0e053e1a"
    },
    "6.2.1.1.1": {
      "text": "進化牌堆的卡片為0張時，出示沒有進化牌堆一事。",
      "source_sha256": "44d5f288a5d2afaa117b7e28ba45caffe48c12daa712a22be2dbde5270f6d46b"
    },
    "6.2.1.2": {
      "text": "各玩家將主戰者卡放置到主戰者區。",
      "source_sha256": "5faf7d8b4169e3b8512e4aab695e87fe9357b20578a40df5229fdb1cf7c851fb"
    },
    "6.2.1.3": {
      "text": "主戰者卡同時具有職業與作品名時，宣告目前的牌堆是以職業與作品何者為基準（6.1.1.5）。",
      "source_sha256": "889a3176ad36f96d74582f3c17c3b1296f37c8ad53983eabbba2b58d9a2c9f90"
    },
    "6.2.1.4": {
      "text": "各玩家將主牌堆放置到自身的牌堆放置區，並將其洗牌。",
      "source_sha256": "9ee87957f380e43566a2e61b219eba9328a52ec36f23d16afdec7c20a086fdd8"
    },
    "6.2.1.5": {
      "text": "有進化牌堆的各玩家將進化牌堆放置到進化牌堆放置區。",
      "source_sha256": "b41a25a6466e3aa280172bdfc28a24894b933a739480cf85e44acba8caa89379"
    },
    "6.2.1.6": {
      "text": "隨機決定其中1名玩家，該玩家選擇自己為先攻或後攻。",
      "source_sha256": "bc412580f50dcb051ff9cbbaaddece53c0fc02587570b35cb3864e3355b5cadf"
    },
    "6.2.1.7": {
      "text": "各玩家將自己牌堆頂的4張卡片移動到自己的手牌。",
      "source_sha256": "fd3be701e55f2a4d9f2c1f96f7ea4415ed26c39cd78b73cb7146c1669b931ebf"
    },
    "6.2.1.8": {
      "text": "從先攻玩家起依序，各玩家若希望如此，可以將自己手牌的卡片以任意順序移動到自己的主牌堆底，並將自己牌堆頂的4張卡片移動到自己的手牌。此事各玩家各只能執行1次。",
      "source_sha256": "32a93c5245c0c7eb5919afa447da7f9197181e095aec1bf56097ebeb272837b0"
    },
    "6.2.1.9": {
      "text": "使各玩家的PP與PP最大值變為0。",
      "source_sha256": "6beb15ea3ba9d2c3aba3ff720c50adc9323f2da315e0f766a6fff126fc95f524"
    },
    "6.2.1.10": {
      "text": "使先攻玩家的EP變為0，後攻玩家的EP變為3。",
      "source_sha256": "a27743e7b1a01c7161d1da5c07706d90f1c77c47838b962025e93075bce8e185"
    },
    "6.2.1.11": {
      "text": "使各玩家的SEP變為1。",
      "source_sha256": "4573efacfcd6232fa87f12a9b9830c35c17b5c58dda2e0a598691d8ce15fe701"
    },
    "6.2.1.12": {
      "text": "使各主戰者的生命值變為20。",
      "source_sha256": "65f82b81a083dc0bf901430614d09f250f882a617ea7ae1faf69d868cba6c598"
    },
    "6.2.1.13": {
      "text": "各玩家自己的牌堆內或戰場上的卡片中，若有具有在「遊戲開始時、執行重抽後」處理的能力的卡片，在此時點進行處理。",
      "source_sha256": "85249f1ae6493c1fa68ef637701c7becfa9ff644bb5deddda09f4679952472c1"
    },
    "6.2.1.14": {
      "text": "以先攻玩家為回合玩家，開始遊戲。",
      "source_sha256": "dabcc67710ecfbf84c1dbb6708c1cae5a6bc474bc3a0a9e5bb3edcb12c9fceef"
    }
  }
}
