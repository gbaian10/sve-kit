{
  "format": 1,
  "kind": "comprehensive-rules-translation",
  "version": "1.28.0",
  "language": "zh-TW",
  "entries": {
    "5": {
      "title": "特定表記",
      "source_sha256": "3a799ed7edfd951f283181cf64ea48773c38a4d74e7632e156705c9ee2fb7d11"
    },
    "5.1": {
      "title": "概要",
      "source_sha256": "1420552cea6d1b22adfdf818db9078179545caa73907f90aa0f9ce0cd905008b"
    },
    "5.1.1": {
      "text": "特定表記是指進行本遊戲時具有特別意義的行動指示或狀態，或卡文上的記載。",
      "source_sha256": "3477712059b11f379c03df1bc3959a08ec4026d3274a444ca91f2522b79b0617"
    },
    "5.2": {
      "title": "X",
      "source_sha256": "e3dd3e7a8df9daf072bf38a22d415daebb7137e58496c13f577a54b9dbd244f0"
    },
    "5.2.1": {
      "text": "卡文中的某個數值以「X」指定時，依下列規定決定該數值。",
      "source_sha256": "c14b8e9d631a0e9ca9bd63f3e23220adf44a76b4cb1bcb618188773f6c12fa6e"
    },
    "5.2.1.1": {
      "text": "X的值在卡文內不論玩家的意圖而決定為特定的值時，X的值即為該值。",
      "source_sha256": "717f20b56f156b6a3e16b935dc598e07906596ab6b669fc16586be808aed1efa"
    },
    "5.2.1.2": {
      "text": "X的值並非不論玩家的意圖而決定為特定的值時，X的值在使用該卡片或能力時決定（10.6.2.2.3）。",
      "source_sha256": "f7bb771bda4cea00394cb9dcc160a08398b99ede59d5df90f519c0a6a5573b0b"
    },
    "5.3": {
      "title": "PP",
      "source_sha256": "820122e1c8dc54e51cd6c56fd1fda90a7a3b6d5a9b28600e6f646a892309344a"
    },
    "5.3.1": {
      "text": "卡文中以綠色圓形{PP}記載者，意為該記載的值的PP（3.2.2）。",
      "source_sha256": "c35dcefa994fbe339e27b8fa5f690c6e0325c2eaa0afd1222ba34c15bcdcffde"
    },
    "5.3.1.1": {
      "text": "記載為數值時，意為與該數值相等的值的PP。",
      "source_sha256": "ce1a4d29e315ce81ae1faa5087559a704fdb1362a19ae1a78ba29ed2e1080e2a"
    },
    "5.3.1.2": {
      "text": "記載不是數值而是X時，意為該X的值在該卡文內定義（5.2）。",
      "source_sha256": "51c820a4be40a3c2f8066364bee28f3aa7497e6ed0639fdadbc50f57e6179d28"
    },
    "5.3.1.2.1": {
      "text": "像「{消費X}{消費X}」這樣記載多個X的PP圖示時，意為以X決定的值與圖示數量的乘積之值的PP。",
      "source_sha256": "6f2f2fb1dd11376d46d0626488b3d61e1f10afd73475bb179567bc51e4631632"
    },
    "5.4": {
      "title": "重置/橫置",
      "source_sha256": "712098208dcb6c08a4c09293f24dfc0401ed2ac540141089ca39a230d4de343c"
    },
    "5.4.1": {
      "text": "有將卡片「重置」或「橫置」的指示時，依該指示將所指定卡片的方向變為重置狀態或橫置狀態。",
      "source_sha256": "9e5e72cbf3e33fb3d49f195940b88a21892764a9c07fbde00af0037e8ee786f8"
    },
    "5.5": {
      "title": "放置/召喚",
      "source_sha256": "6da11c313ab5c23b8000338b272b0671363ed0f323bd28535fd2c0dc0303d7c9"
    },
    "5.5.1": {
      "text": "有將卡片「放置」或「召喚」到指定區域的指示時，將該卡片移動到該區域。",
      "source_sha256": "befbf854f5d755125bdbf05766ffb41a58149cba881409e46e3fed2748c22dc8"
    },
    "5.5.2": {
      "text": "有「將（數值）張『（Token名稱）』放置到（區域）」的指示時，在自己的指定區域建立指定數量的該名稱的Token（9.1.2）。",
      "source_sha256": "951ea02b482be887619e4360d1200a8f7da262e10f8a52c3b6dd7be00a5bbed4"
    },
    "5.5.2.1": {
      "text": "「召喚（指定數量）的『（Token名稱）』」的指示，意為「將『（Token名稱）』放置到自己的戰場上」。",
      "source_sha256": "e0a527e4934c42855d6755e7ba5d4a82f02de0c0e80cbcbc19a8d59e4498990b"
    },
    "5.5.2.2": {
      "text": "有指示要放置某個特定名稱的卡片，且該名稱與某個Token的名稱相同時，該指示放置的是該名稱的Token。",
      "source_sha256": "ad5970ba0323041027167f86d377e7e08ec2a27fe2319fbb2a7a72a534878980"
    },
    "5.5.3": {
      "text": "參照卡片「從（區域）進入戰場」時，是同時參照該卡片從該區域直接進入戰場，以及該卡片從該區域被使用後在結算區結算而進入戰場這兩者。同樣地，參照卡片「從（區域）以外進入戰場」時，是同時參照該卡片從既非該區域也非結算區的區域直接進入戰場，以及該卡片從該區域以外的區域被使用後在結算區結算而進入戰場這兩者。",
      "source_sha256": "b550a325a8c05055cef46750543ed624f5a6e088dbbb3c86b862fde548e7581f"
    },
    "5.6": {
      "title": "破壞",
      "source_sha256": "48a936a18b5701611a5046614fef441a5448ec773b6fe369429a545d62099afd"
    },
    "5.6.1": {
      "text": "有將戰場上的卡片「破壞」的指示時，將該卡片移動到所有者的墓場。",
      "source_sha256": "9d39190ed1ff045307a4c2a17d5b18f7d640cb8093afd7e6dcf6da676643c71d"
    },
    "5.7": {
      "title": "消失",
      "source_sha256": "100dff70525059cf2b0b4cd466697f9712f2f52c6fa7ad440a71a4bba7bdead5"
    },
    "5.7.1": {
      "text": "有使卡片「消失」的指示時，將該卡片移動到所有者的消失區。",
      "source_sha256": "a5d2d57b5fee29868546e39111dc9367d6add7a73067e2c583da56424f25ff62"
    },
    "5.8": {
      "title": "搜尋",
      "source_sha256": "14f7f1c86fe68eda8f385d51cbfd87471907f846655bad2dd66bf112442c3a44"
    },
    "5.8.1": {
      "text": "有從牌堆「搜尋」特定條件的卡片的指示時，只有自己確認牌堆的內容，並找出符合的卡片。",
      "source_sha256": "0e9197c29021768ae838c5c5611e909ed9c3e605fa40372cab6f59bfe959e8ea"
    },
    "5.8.1.1": {
      "text": "特定條件只有張數時，必須找出該張數的卡片。不能選擇不找出。",
      "source_sha256": "61f6cbf41a92cd92792ade8a99deceea5c212f5d4d325c18fa2316d50481e478"
    },
    "5.8.1.2": {
      "text": "特定條件有張數以外的條件時，找出後，向敵方出示該卡片滿足條件。",
      "source_sha256": "328da25371ffe2c84640302bcea373b941c67d3c05df375079a54180193f69ca"
    },
    "5.8.2": {
      "text": "從牌堆搜尋卡片，並將找出的卡片移動到指定的區域、選擇不移動找出的卡片，或沒有找出卡片之後，將該牌堆洗牌。",
      "source_sha256": "b2d0fc1354d3ce37a1308f44ffc45e29c35e79a0a88cf6bd413de85e416f4246"
    },
    "5.9": {
      "title": "洗牌",
      "source_sha256": "5e085333f89ec67b2dc563c13a1db421d8f826218a2a1988f4d4defb8f1a56b9"
    },
    "5.9.1": {
      "text": "有將牌堆「洗牌」的指示時，該牌堆放置區所屬的玩家將該牌堆放置區中的卡片順序隨機變更。",
      "source_sha256": "5db21ab331a1c116e454dc20e2e32aa97866c0927819e0029c7b4a79b46398a0"
    },
    "5.9.1.1": {
      "text": "牌堆放置區為0張或1張的狀態下，有將該牌堆放置區洗牌的指示時，該處的卡片順序不會變更，但視為已進行洗牌。",
      "source_sha256": "f507edee1cf8aa1414982a4831875b8b6b92f43bad788b840b214d8576af2701"
    },
    "5.10": {
      "title": "抽",
      "source_sha256": "015b863a976d23267e6ae309a2fb102f5e7a26e86eb92eef46b81ad3856703bb"
    },
    "5.10.1": {
      "text": "有「抽1張卡片」的指示時，將指定玩家的牌堆放置區最上方的卡片移動到指定玩家的手牌。",
      "source_sha256": "cae86fa8344f425577f19d4805dd7bce5cda3e54c41321b91619558e31d304f6"
    },
    "5.10.1.1": {
      "text": "執行此指示時，若該玩家的牌堆放置區沒有卡片，該玩家在下一次規則處理時於遊戲中敗北（11.2.2）。",
      "source_sha256": "d720532e18630384fab06465f8bb413a61e9018ac8e08424f6961c53bee8acea"
    },
    "5.10.2": {
      "text": "有「抽N張卡片」的指示時，指定玩家重複N次抽1張卡片的行動。",
      "source_sha256": "b1c31c9a603be42c489fab176277e6b192d86578c36c52d9bcb08d5586911095"
    },
    "5.10.3": {
      "text": "有「抽至多N張卡片」的指示時，指定玩家執行下列事項。",
      "source_sha256": "d2eeb636da4fb7c5c1bd996b50b2de67a81c66c90bedf1ae208d5a99b63f95a0"
    },
    "5.10.3.1": {
      "text": "指定玩家可以結束此指示。",
      "source_sha256": "208378c3ded06ba04b24334948c1a76ef0030c46d91f9a2d9d2fc98f67fe3abe"
    },
    "5.10.3.2": {
      "text": "指定玩家抽1張卡片。",
      "source_sha256": "d5530a8208e31ef9600430c154022e2ec46748212e45b1c8ad54b89aa1b1db79"
    },
    "5.10.3.3": {
      "text": "依此指示執行5.10.3.2的次數已達N次時，結束此指示。否則，回到5.10.3.1。",
      "source_sha256": "4c2cf88c2684ca36b491bb87c6f97be1001ab756f58376334b0a31b753cdab1d"
    },
    "5.11": {
      "title": "從上查看",
      "source_sha256": "7b9ba45e6fdab6f4aa9c4238adaf452470bc2d535a19d09e761b77005da45f08"
    },
    "5.11.1": {
      "text": "有「查看牌堆頂的N張卡片」的指示時，指定玩家可以得知該牌堆放置區從最上方起N張卡片的資訊。",
      "source_sha256": "79833469e7902d22184486fdd71602fe6a37e3e389931e89b916bdd792f5abfa"
    },
    "5.11.2": {
      "text": "有「查看牌堆頂的至多N張卡片」的指示時，執行下列事項。",
      "source_sha256": "44db80b673b593804b06fb58a8c392db55b3b9a4b5973bd699fb5414e452e9ae"
    },
    "5.11.2.1": {
      "text": "將張數指定為1。",
      "source_sha256": "f2b68fb3c33a36915c2f8f67df84490d114353106833b210f1e7d0796d36c1a8"
    },
    "5.11.2.2": {
      "text": "指定玩家可以結束此指示。",
      "source_sha256": "208378c3ded06ba04b24334948c1a76ef0030c46d91f9a2d9d2fc98f67fe3abe"
    },
    "5.11.2.3": {
      "text": "指定玩家可以得知牌堆放置區中，從最上方數來位於指定張數那一張的卡片的資訊。",
      "source_sha256": "65b3d4377028a0d492b48bb36b8305027fdbf17d5ea275ca1c6a4ebe9212a316"
    },
    "5.11.2.4": {
      "text": "依此指示執行5.11.2.3的次數已達N次時，結束此指示。否則，將張數增加1，回到5.11.2.2。",
      "source_sha256": "3b9bab8303e6dbde77c4c0cacb0b2e7b44a0a251706d1d708ae56d0343aac4a7"
    },
    "5.12": {
      "title": "捨棄",
      "source_sha256": "2cbe89717e59ff65f3454c8e22c293efb4442d9b5c9a1a6dd8326b9d2eda60b8"
    },
    "5.12.1": {
      "text": "有「捨棄」卡片的指示時，所指定的玩家選擇指定張數的自己手牌中的卡片，將其移動到自己的墓場。",
      "source_sha256": "45a132ed3a268b97494e0adb6d0763ff8ca5f026527be804fc94584cb984b677"
    },
    "5.13": {
      "title": "交換",
      "source_sha256": "3a869280344a6c22a51e7edec607749a6005b6ddf3fe5a922184af1ea6839d96"
    },
    "5.13.1": {
      "text": "有將某張卡片與另一張卡片「交換」的指示時，同時將前者的卡片移動到後者的卡片所在的區域，並將後者的卡片移動到前者的卡片所在的區域。",
      "source_sha256": "39fbff1f94f8b360a15e20b86491baa5c0a64eeaa9f0cb8941edf3ce2c972359"
    },
    "5.13.2": {
      "text": "因某種原因，執行交換的指示時任一張卡片無法移動到另一方的區域時，不執行該指示。",
      "source_sha256": "36670f99dd7c90702562746dc449a7c59bcbf8d8391cc3977caf21745fce6160"
    },
    "5.14": {
      "title": "傷害",
      "source_sha256": "77e49c72fe04bd130de6f570955fd0ee6f464221ca4c55f0c1f33ecf44ccea91"
    },
    "5.14.1": {
      "text": "對從者或主戰者有「（數值）點傷害」或「給予（數值）點傷害」的指示時，使該從者或主戰者的生命值減少與（數值）相等的值。",
      "source_sha256": "744f2d53ccb35ae24a59f23007e048a4e5fba1ee9f8390c6766aaf526a4c24be"
    },
    "5.14.1.1": {
      "text": "因此，生命值可能變為負值。",
      "source_sha256": "aa6400cd62b4ad34a1d4b55c1678d2cf0a7a9361028fd204b3d4283beb059c47"
    },
    "5.14.1.2": {
      "text": "有指示要對既非從者也非主戰者的卡片給予傷害時，不會給予該傷害。",
      "source_sha256": "faf0d5ef9ab05a46fd17b2cb38af2784aae471588c33143a4dd57db35d4ee294"
    },
    "5.14.2": {
      "text": "「傷害＋（數值）」等修正傷害的效果，是作為置換效果適用，其不給予該傷害，改為給予對該傷害的值加以修正後之值的傷害。",
      "source_sha256": "cbda3ef162bc700c602314c06269b64e9f6e6a94357553d635cd8c1b170f1111"
    },
    "5.14.3": {
      "text": "傷害依其記載不同，參照的內容也不同。",
      "source_sha256": "1bb0f964d4c1a6a5a1771fe707a9b4ef7f3524b7ee084baedcf2169b8ecde51a"
    },
    "5.14.3.1": {
      "text": "卡文參照「攻擊傷害」時，參照攻擊從者依8.4.9給予攻擊目標的傷害。",
      "source_sha256": "dbcf694dd9522e2caa75e4f19f116880579c01b613e83727fbd46a75931d29cc"
    },
    "5.14.3.2": {
      "text": "卡文參照「交戰傷害」時，參照在處於交戰狀態（8.4.5.1）的狀況下，攻擊從者與攻擊目標依8.4.9互相給予的傷害。",
      "source_sha256": "d82a00780e09a0b5fab7261c013638a223b976eef5fdb8568d55cc7f407a49ff"
    },
    "5.14.3.3": {
      "text": "卡文參照「能力傷害」時，參照依8.4.9給予的傷害以外的一切傷害。",
      "source_sha256": "b90023d0a38854924f73276edb2c733380a077d9c632807859b018d1b476f48f"
    },
    "5.14.3.4": {
      "text": "卡文未特別指定其類別而僅參照「傷害」時，是參照攻擊傷害、交戰傷害與能力傷害全部。",
      "source_sha256": "6d915da92a394e6af5507c6c3ecccdc8e604bf996d07d5f4f1c2781749a3655a"
    },
    "5.15": {
      "title": "回復（PP）",
      "source_sha256": "7ef2ad3b8ca53824ab9324eef8a585f30072f5a54392247435dc4920cca91a57"
    },
    "5.15.1": {
      "text": "有使某名玩家的PP「回復」某個值的指示時，在該玩家目前的PP加上該值。",
      "source_sha256": "9c060827eb82c38814bfebb89c79468e95f965b28dc60cdd74dcec0dc341cbe0"
    },
    "5.15.1.1": {
      "text": "若因此使該玩家的PP超過該玩家的PP最大值，則不是在PP加上該值，而是使該PP變為該PP最大值。",
      "source_sha256": "40f2c731453e18bdaaf0769e624c4864b6ef6d1abeb5227c29a02c99721e7466"
    },
    "5.16": {
      "title": "進化",
      "source_sha256": "4ce4994a56519265f1074421034b9ebecbbd804c16b4257f999b987893b502bc"
    },
    "5.16.1": {
      "text": "有使戰場上的某張卡片「進化」的指示時，若該戰場上的卡片不具有特殊種類「進化」，則指定該卡片的操控者的進化牌堆放置區的卡片中的1張，將該卡片放置到該操控者的進化區，再將其與該戰場上的卡片建立關聯。",
      "source_sha256": "4fac3c06f3e49c08bdee8888f3b22530a8d7de693a68555e650fae42f45fead9"
    },
    "5.16.1.1": {
      "text": "此「進化」處理是由進化能力（12.1.2.1）進行時，以作為其消費而公開的卡片為所指定的卡片。否則，從進化牌堆放置區背面朝上的卡片中選擇1張合法的卡片，將其公開並指定。",
      "source_sha256": "015d2811e52bf0348cef4a1620fca8adfbb0efcdc6454d4b60093bed0ab6d539"
    },
    "5.16.1.1.1": {
      "text": "除非效果另有變更或指定，合法的卡片是指與該卡片相同卡片名稱的卡片。",
      "source_sha256": "0faa6012ad67d44935a90b59e05e2f4a6917a0c70360fdc2cb8635dc0de6910b"
    },
    "5.16.1.2": {
      "text": "此後，在戰場上的卡片與進化區的卡片有關聯的期間，該卡片的資訊除消費以外，視為具有該進化區的卡片的資訊（10.9.1.1.1）。",
      "source_sha256": "ef182cd65c66a9a379222a4696d418fcd141534a5e1a91237b7d897a7016a349"
    },
    "5.16.1.2.1": {
      "text": "若因此使進化前與進化後的卡片種類不同，則該卡片記載的種類資訊（10.9.1.1）變為進化後的種類。若沒有適用其他變更種類的效果，則藉此使該卡片的種類變為進化後的種類（5.25）。",
      "source_sha256": "1ee772fdee4d383ea561a1d18a846a0937fdd343a6b46a55097db189ccc7844d"
    },
    "5.16.1.3": {
      "text": "執行此處理後，發生該卡片「進化了」的事件。",
      "source_sha256": "7cc506a7f8b45ecda210372d483596020497a8b3c726b24d644120aafc43c756"
    },
    "5.16.1.4": {
      "text": "在遊戲上，此關聯以將進化區的卡片疊放在原本的卡片上來表示。",
      "source_sha256": "3f3a9703b8d85bc0601d098e5d987e84adcced18c16aefc6242895ea28e5c2ab"
    },
    "5.16.2": {
      "text": "卡片進化後，該卡片仍視為與先前相同的卡片。其重置/橫置狀態不變，原本適用於其上的效果也繼續適用。",
      "source_sha256": "2272f739eff126d9ebb51f064ff4889f4e13f6ec1172e9efcae0a65bc7634e27"
    },
    "5.16.2.1": {
      "text": "進化前卡片的攻擊力或生命值與進化前卡片的原始攻擊力或生命值不同時，將與該差值相等的值，加減於進化後卡片所記載的攻擊力或生命值。",
      "source_sha256": "aa93c21bf5b9fb13ea25be3743cb71536481ce33a9dc8821c82ce9e12a4c8eca"
    },
    "5.16.2.2": {
      "text": "進化前卡片上記載的能力視為全部失去，進化後卡片上記載的能力視為全部獲得。",
      "source_sha256": "d293623291042fc40ab132b3b97955e9bcb1c6ede19e48f3f4753b6c35a83727"
    },
    "5.16.2.2.1": {
      "text": "即使進化前卡片與進化後卡片有記載相同的能力，也會失去進化前的該能力，獲得進化後的該能力。",
      "source_sha256": "5ea794d282c6f545b19a5dd08f8fd8486a06798899cc6fdb35529289f9f87b48"
    },
    "5.16.3": {
      "text": "戰場上的卡片移動到戰場以外時，在該移動之後立即失去與該卡片有關聯的進化區卡片之間的關聯。",
      "source_sha256": "f634c8b6415df7cbf2374d50096f01f670131e70c6ab0aab9c72a8b9edc585ef"
    },
    "5.16.4": {
      "text": "有使戰場上的某張卡片「進化」的指示時，若該戰場上的卡片具有特殊種類「進化」，則該「進化」指示不做任何事。",
      "source_sha256": "78a2e76c6b755021ac87e8680d11979b94422beda02701db8fd5e1cdf0b3635f"
    },
    "5.17": {
      "title": "變身",
      "source_sha256": "bbb42af3373c9041f3e3d562185e917e5987f5f789c71aab9e119b9145bc9387"
    },
    "5.17.1": {
      "text": "有使某張卡片「變身為『（Token名）』」的指示時，使該卡片消失，並在該區域新建立與消失的卡片張數相同數量的（Token名）的Token。",
      "source_sha256": "be32e549a234bdb37f493ee6d6f5089291574b035cefb6c7b153089b8309da86"
    },
    "5.18": {
      "title": "抉擇",
      "source_sha256": "a1b37e9e4c6911803fb2be3206d650a92529d71abe4954b031f1138d1aec8597"
    },
    "5.18.1": {
      "text": "卡文中有「抉擇」的指示時，從其後的選項中選擇該抉擇所指定個數的選項，並執行其內容。",
      "source_sha256": "0dcd65cc9fab0bfc4cc1f4db84ccb5b4229900a7b8e9c822c1c2f05af716897d"
    },
    "5.18.1.1": {
      "text": "選項以「【（數值）】（卡文）」的形式記載，到下一個數值記載之前，或到該能力的卡文最後為止，是對應該數值的選項。",
      "source_sha256": "23751e354f0442183d50af00f92881ee5932408b8810021daf7712fd7e31e63a"
    },
    "5.18.2": {
      "text": "依抉擇所指定的個數，適用下列規則。",
      "source_sha256": "a674377e5e9a33241126b3f1e25fd1ae848313d548a705438562fb5dc467340d"
    },
    "5.18.2.1": {
      "text": "有「抉擇至多（數值）項」的指示時，選擇1以上、至多（數值）的值，選擇該個數的選項並執行。",
      "source_sha256": "fe7cf5fddc7d0b99a2af7013ea7d59fb62ab0c0036edab6d6e538e77175b5d57"
    },
    "5.18.2.2": {
      "text": "抉擇的個數為0時，完全不執行該一連串的指示。",
      "source_sha256": "c2cbc76cf393092cf9ba059e74d9fe80836908f905a8f654280ada29965ca4c4"
    },
    "5.18.2.3": {
      "text": "抉擇的個數超過選項的數量時，該個數視為與選項的數量相等。",
      "source_sha256": "283adb7912715521e2a60ef343267c1c15e12c6b9568d0e93e5bff408f4025db"
    },
    "5.18.3": {
      "text": "在抉擇的行動中決定採用哪個選項的處理，是作為使用前提的選項（10.6.2.2）。因此，抉擇的行動所做的選擇必須在使用的階段進行。",
      "source_sha256": "545698bf09672e35d6abece17cd027f729e3abf28942e779e9cc5ee14cc86bfe"
    },
    "5.18.3.1": {
      "text": "為了決定抉擇的行動中採用的選項數量而參照某個條件時，是參照開始使用的時點的該值或條件。",
      "source_sha256": "48ab2a0bb8286940b9e7e6e1610d81c24a1175b7fb0870303a0aa506770728f0"
    },
    "5.18.3.1.1": {
      "text": "魔力連鎖（13.3.1）或死靈充能（13.5.1）等，原本在效果結算時決定的數值，為了決定抉擇的行動中選擇的選項數量而被參照時，僅就該目的，參照開始使用的時點的值。",
      "source_sha256": "555df7689f964a1922be252df7a64f4bbe0b96cca50cd56c9c231b09c8012782"
    },
    "5.18.3.1.2": {
      "text": "所選擇的選項必須是可以合法使用的選項。若選擇該選項時，因某種原因無法合法使用該選項的部分，則不能選擇該選項。",
      "source_sha256": "9f5e62857def402911701fad582e5e66a07625baec5a8400f52efe8fdbf2415a"
    },
    "5.18.4": {
      "text": "使用卡片或能力時，在選擇了抉擇的行動中採用的選項之後，該選項以外的選項視為不存在。",
      "source_sha256": "a324223e752c97ffb54a3da8e1c05506b20e24ade2de9aaf17abaea462eba3af"
    },
    "5.18.4.1": {
      "text": "在視為不存在的選項內，不會選擇「選擇」處理的目標，使用該卡片或能力時即使不存在其合法的目標也可以使用。",
      "source_sha256": "fc24cfbc53d6e79da1fceded65f6d5543e6332ef337f15f9fd5465f000426a2d"
    },
    "5.19": {
      "title": "隨機",
      "source_sha256": "7dc07c6e0c289904e851e0404fede84915087f6eb483fc56bb2406cd0876500f"
    },
    "5.19.1": {
      "text": "卡文中有「從（卡片群或區域）隨機（數值）張」這樣的記載時，參照從該卡片群或該區域內的全部卡片中，以某種方式隨機選出的（數值）張卡片。",
      "source_sha256": "07c190dc5bbb995ef562e8ed3458f0b1501cc98ca2f8d840be47dd350c147bf2"
    },
    "5.20": {
      "title": "擲骰子/重擲骰子",
      "source_sha256": "fed69e5ded304d4efe497e0f4186bd04cb55dec7dee6066c127c9ea0829a516b"
    },
    "5.20.1": {
      "text": "卡文中有「擲骰子」的指示時，擲1個一般的6面骰子，以擲出的點數為基準執行其後的處理。",
      "source_sha256": "48ba61a1c6b8b82ac269ea45f66170993ec67aff764e55ea01d1c9035e3ce226"
    },
    "5.20.2": {
      "text": "卡文中有「重擲骰子」的指示時，不將緊接在前的擲骰子指示所得的點數適用於其後的效果，改為再次擲骰子，並將新擲出的點數適用於其後的效果。",
      "source_sha256": "9d9e21497669354c3209e7073bf065c86a241d7103f61893b063eb3ea9f8e2b2"
    },
    "5.21": {
      "title": "公開",
      "source_sha256": "ba79bc3b05ce632bc0f480ef5f442e2a6a11b4cbe2bee85ca96cb0bc3779c5cf"
    },
    "5.21.1": {
      "text": "有「公開」卡片的指示時，使該卡片在位於目前區域的狀態下，其資訊可被全部玩家看見。",
      "source_sha256": "d6658e596d6f375c83b36035192f246536d9830f28b639c62024f0dd87762746"
    },
    "5.21.1.1": {
      "text": "藉此公開的卡片位於非公開區域時，在該卡片移動到其他非公開區域或同一非公開區域的其他位置時，或是包含使該卡片公開之處理的效果結算結束的時點，該卡片恢復為非公開。",
      "source_sha256": "74077315944d24fe5ed5d807ba7db7d6448172905d47971b50a9e23fff2e8d08"
    },
    "5.22": {
      "title": "奪取/交給",
      "source_sha256": "47b5f33467d619fc15d17b75928412eeb014a6587fa6d08424c110da7f884e06"
    },
    "5.22.1": {
      "text": "有「奪取」敵方戰場上的卡片的指示時，將該卡片移動到自己的戰場。移動後，該卡片的操控者變為自己。",
      "source_sha256": "ccacbf05bd5979af8f7fe81a9b0195ccbdaff8e022ead3db3c3b57b0e824b4b6"
    },
    "5.22.2": {
      "text": "有「交給」自己戰場上的卡片的指示時，將該卡片移動到敵方的戰場。移動後，該卡片的操控者變為敵方。",
      "source_sha256": "47ceb784b0253e5988b1731100778578df4da828388717d9995f3ec2f83bce46"
    },
    "5.22.3": {
      "text": "即使卡片的操控者變更，卡片的所有者也不會變更。",
      "source_sha256": "3cd4df9a24e0af7c33eeceee9a4216cf9c36da6dc47dbbbaf391ffc61cfd5769"
    },
    "5.22.4": {
      "text": "奪取或交給的卡片不是新進入戰場的卡片，其繼續具有該卡片先前具有的全部資訊與狀態。",
      "source_sha256": "87f349584b3626ce55d36f7fd3670207323fe0c64961331af7d4e85c30d73624"
    },
    "5.22.5": {
      "text": "奪取或交給的卡片移動到戰場以外的區域時，移動到該卡片的所有者的區域。",
      "source_sha256": "d93fd98be0238f38acb2312431ac75810585e4ceada68e4b1f1ecd2c5f85112c"
    },
    "5.23": {
      "title": "贏得對戰/在對戰中敗北",
      "source_sha256": "db4ad84d18ef0f42031c8208e9e785ab08608712ec5582af0798d01b85c15dc4"
    },
    "5.23.1": {
      "text": "效果指示所指定的玩家「贏得對戰」時，該玩家以外的全部玩家在本場遊戲中敗北。",
      "source_sha256": "37b1b8e151fd4336e1ee6f67ea934edc707857e839d21055d65a5ef964743bdc"
    },
    "5.24": {
      "title": "原始",
      "source_sha256": "8554c4477755bc5b7a3f094372eaebb64005326690d20cb679be786c49013c0d"
    },
    "5.24.1": {
      "text": "參照某張卡片的「原始」資訊時，是參照該卡片本身記載的資訊。",
      "source_sha256": "3b8c797383ef0130422b4c7375587a580566cf17258d4091a169f5a33aac92fb"
    },
    "5.25": {
      "title": "變為（種類）",
      "source_sha256": "da26babb16b396ede46729d8bfdea1a85a4a4db4a95c9f0ebe4c28fb2a348d9b"
    },
    "5.25.1": {
      "text": "有使某張卡片「變為（種類）」的指示時，該卡片的種類會失去原本具有的種類，變為新指定的種類。",
      "source_sha256": "1805b837c0a129ae65033794ec940711b848bf701c65ff1113b08caf122d9a17"
    },
    "5.25.2": {
      "text": "即使卡片的種類變更，該卡片原本具有的種類以外的資訊仍照原樣保留；但若要參照該種類原本不具有的資訊，則不會參照。",
      "source_sha256": "b0288e48218ee9666f2052eec9eaa1a7e9238973f1a96ac45d516e5cceb89474"
    },
    "5.25.2.1": {
      "text": "不是從者的卡片，無法參照其攻擊力或生命值。",
      "source_sha256": "9e470eda10ca91e96d73321808c4a11393059c7a0d5f1ce02223881ae6d36f07"
    },
    "5.25.3": {
      "text": "即使卡片的種類變更，該卡片具有的能力也不會變更。",
      "source_sha256": "569ef336f0aa69b1eeafe7146764d707ac18caf05ebe8194aa332eef9aa1fee1"
    },
    "5.25.3.1": {
      "text": "某張卡片的能力記載著「這個（種類）～」，而該卡片目前的種類不是所指定的種類時，其後的效果不適用。",
      "source_sha256": "d56d646b0f4bb89edfbe3f42f96e25e0908756cdad76ffc8f09587b1b77df18c"
    },
    "5.25.3.2": {
      "text": "從者以外的卡片也可以進化（5.16）。",
      "source_sha256": "14a01f3530f01129e127c9c950ed488a80b41d506e9a5abeb178e38d82fe2616"
    },
    "5.26": {
      "title": "跳過回合",
      "source_sha256": "40fd5a7220abee7c0590c3dee244828feee44b6236b6fffac41c2079fe4ce857"
    },
    "5.26.1": {
      "text": "有「跳過」某個回合的指示時，在開始該回合的時點，不開始該回合，改為開始該回合的下一個回合。",
      "source_sha256": "f6eba4abbef417690e013f3eccdb17b93c1e5e5e8a3d136a3b3382e0bed0fe97"
    },
    "5.26.2": {
      "text": "有「跳過（玩家）的下一個回合」的指示時，在該玩家下一次開始自己的回合的時點，跳過該回合1次。",
      "source_sha256": "265dc17ad05f04eb5a85e9913a77d25cdbc9d9a613cfaf40074f7adc9bad9f19"
    },
    "5.26.2.1": {
      "text": "有多個「跳過（玩家）的下一個回合」的指示時，跳過回合1次，僅視為執行了這些指示中最晚建立的指示。",
      "source_sha256": "902ce8a251f6d9d288cdb57051ce7b36fb4dd24e5e7da3900d613a3abb80a6c9"
    },
    "5.27": {
      "title": "＋/－（增加/減少）",
      "source_sha256": "bf0cc2f6a1d94283f8cc548cfb0b4dd1cbdd5409996ba64fb39e924efe079e32"
    },
    "5.27.1": {
      "text": "某個資訊「增加了」，是指該資訊的數值從目前的值變化為更大的值。同樣地，某個資訊「減少了」，是指該資訊的數值從目前的值變化為更小的值。",
      "source_sha256": "c3643443dd521b80ce0d1b2f3dfe636a84147d0de1f10fc8db62b8f559c7422c"
    },
    "5.27.2": {
      "text": "指定特定的值變更某個資訊時，若新的值大於變更前的值，則視為將該值「增加了」；若小於，則視為「減少了」。",
      "source_sha256": "bb7fcb03b53e179b9ccfd68f8360e0c9e32d60c697a515c038136270a0dcbafb"
    },
    "5.28": {
      "title": "進行額外回合",
      "source_sha256": "029535d857c1749c471ee092e035baf756e4ec9882b1705a6eaf86d220939dc0"
    },
    "5.28.1": {
      "text": "有某名玩家在特定時點「進行額外回合」的指示時，在該時點原本要執行的回合之前，執行1次該玩家的回合。",
      "source_sha256": "62ef18945010e93c6f615f22e9447c3edc4e4ef24197c7a20dfa17a4c421f770"
    },
    "5.28.1.1": {
      "text": "有多個「進行額外回合」的指示時，適用其中最晚適用的1個。在原本要執行的回合之前重複此動作，直到執行完全部「進行額外回合」的指示為止。",
      "source_sha256": "0e06c120ef12a4ae2c77687f1d7abc4e38a76b98db288b00b93ea33a58df4cdf"
    },
    "5.29": {
      "title": "每有～",
      "source_sha256": "a48a7f900a1e7a14e6c6807f1cf5b24464427978769ae96b5bfe71c0d1edef9f"
    },
    "5.29.1": {
      "text": "在某個處理中，以「每有（單位數），（數值）」執行某個行動時，該處理只執行1次以該單位數與數值所決定的值為基準的該行動。並不是將以該數值為基準的該行動，重複執行由單位數決定的次數。",
      "examples": [
        "例：自己的墓場中有12張卡片的狀態下，執行「自己的墓場中每有5張卡片，給予敵方的主戰者1點傷害」這個處理時，執行1次給予2點傷害的處理。並不是執行2次給予1點傷害的處理。此外，墓場中餘下的2張卡片不計入。"
      ],
      "source_sha256": "b18161e071522ca87581a18daab41bdfce7f629eda833e5a03b58a950aafe1b6"
    },
    "5.30": {
      "title": "一半",
      "source_sha256": "4b5dc5cb88d6e61374d868bb5047e5e4e4f9c52e907e249fcb3e9d1c9a8565a2"
    },
    "5.30.1": {
      "text": "參照某個數值的「一半」時，若該數值為奇數，則小數點後無條件進位。",
      "source_sha256": "c2515985a384751df504b4ae022cee3c2e682432186e8f5c89eb20b9d2e6a07b"
    },
    "5.30.2": {
      "text": "參照某個區域中的卡片的「一半」時，參照該區域中的卡片裡，張數為全體張數一半的卡片。",
      "source_sha256": "9acab3f905c54e0a2647a089012f482406dc83b5bf4d883751940eb4d0cf57e2"
    },
    "5.30.2.1": {
      "text": "參照某個區域的卡片的「上半部」或「下半部」時，意為從該區域以「上」或「下」管理的方向的第1張起，到「一半」所規定張數的卡片為止的卡片。",
      "source_sha256": "fe9ba256a461de1daa4436f560e8ab77301faf9e66f87c30354cb984b096e197"
    },
    "5.31": {
      "title": "裝箱",
      "source_sha256": "e769e087b950b896ae4730d4d46a4d6669f60e5215dcf2fc2ad98a048062f032"
    },
    "5.31.1": {
      "text": "卡片有時會變為「【裝箱】狀態」。",
      "source_sha256": "316a2c58c7b68365710889622c720ba7b66830e47007e573c055f98519b95fae"
    },
    "5.31.2": {
      "text": "變為【裝箱】狀態的卡片，在處於【裝箱】狀態的期間，失去該卡片具有的能力，以及變為【裝箱】狀態的時點該卡片已獲得的全部能力。",
      "source_sha256": "852ed0c052b5455b26b6caba1c302a67ff8b09da81e54abc73ca6f6da6bd81a7"
    },
    "5.31.2.1": {
      "text": "變為【裝箱】狀態的卡片之後獲得能力時，會獲得該能力。",
      "source_sha256": "746855c5e8bb53cf1c01e42e39c7ef3ae7c15425094757373d4a178bc2588585"
    },
    "5.31.3": {
      "text": "【裝箱】狀態的卡片，在其玩家的開始階段中，不執行依規則的重置（7.2.3）。",
      "source_sha256": "38c6707277c0ea349027d970649132c64028b64ccb2f3b895f37ebdd7a555aa4"
    },
    "5.31.3.1": {
      "text": "包含開始階段中在內，【裝箱】狀態的卡片因某個效果而重置時，該卡片會重置。",
      "source_sha256": "6a003dc2f217c085a17cc0db16261894366331f21b784cb14c97f7e5728b7fd2"
    },
    "5.32": {
      "title": "操縱",
      "source_sha256": "1ad4438e62bfd844506611ddd621d9134ff537ddbb5cfd720474358cebdac49a"
    },
    "5.32.1": {
      "text": "有「操縱」某個護符的指示時，若該護符具有卡片上記載的攻擊力與生命值，則在該回合期間，該護符變為從者，攻擊力與生命值變為該值。",
      "source_sha256": "c562a21f1660a5f1ba4b25a98400705fcdfab5aced1d7da39fe635624a63e1de"
    },
    "5.32.1.1": {
      "text": "該護符不具有卡片上記載的攻擊力或生命值時，「操縱」處理不做任何事。",
      "source_sha256": "a19235741e61f74684b431bedfb0662762bd6d42caf7c78087d682d8349bb63e"
    },
    "5.33": {
      "title": "指定卡片名稱",
      "source_sha256": "578e7a5f234c7865ef127381800b7c346bf88fc1218c45fefff5f9fda37e670b"
    },
    "5.33.1": {
      "text": "有「指定卡片名稱」的指示時，必須指定Shadowverse EVOLVE中實際存在的卡片或Token的卡片名稱。",
      "source_sha256": "4b5590a61174982a0fdfbc621f48183be63974f918715696fb06d4a94ab623bd"
    },
    "5.33.1.1": {
      "text": "指定卡片名稱時，不能指定合作名稱（2.14）。",
      "source_sha256": "8cb4a83e5af8911ec377373a3b8bb881c550e39a58cb9db5280bc6a3affdd09b"
    }
  }
}
