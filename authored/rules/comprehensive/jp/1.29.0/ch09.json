{
  "format": 1,
  "kind": "comprehensive-rules",
  "version": "1.29.0",
  "nodes": [
    {
      "key": "9",
      "context": "main",
      "number": "9",
      "kind": "chapter",
      "depth": 1,
      "title": "特殊なカード類に関する処理",
      "text": ""
    },
    {
      "key": "9.1",
      "context": "main",
      "number": "9.1",
      "kind": "section",
      "depth": 2,
      "title": "トークン",
      "text": ""
    },
    {
      "key": "9.1.1",
      "context": "main",
      "number": "9.1.1",
      "kind": "rule",
      "depth": 3,
      "text": "ゲーム中、いずれかの領域にカードと同様の扱いをする‘トークン’が作成されることがあります。"
    },
    {
      "key": "9.1.1.1",
      "context": "main",
      "number": "9.1.1.1",
      "kind": "rule",
      "depth": 4,
      "text": "トークンはカードではありませんが、カードと同様に扱い、それが存在する領域でのカードの枚数に数え、カードに適用される効果の適用を受けます。"
    },
    {
      "key": "9.1.2",
      "context": "main",
      "number": "9.1.2",
      "kind": "rule",
      "depth": 3,
      "text": "ある領域にトークンを‘作成する’とは、その領域に指定のトークンが存在する状態にすることを意味します。"
    },
    {
      "key": "9.1.2.1",
      "context": "main",
      "number": "9.1.2.1",
      "kind": "rule",
      "depth": 4,
      "text": "作成されたトークンのオーナーやマスターは、そのトークンが作成された領域が属するプレイヤーです。"
    },
    {
      "key": "9.1.2.2",
      "context": "main",
      "number": "9.1.2.2",
      "kind": "rule",
      "depth": 4,
      "text": "トークンをある領域に作成した場合、そのトークンはその領域に置いたものとみなされます。"
    },
    {
      "key": "9.1.2.3",
      "context": "main",
      "number": "9.1.2.3",
      "kind": "rule",
      "depth": 4,
      "text": "そのトークンがどのような情報を持つかは、そのトークンのカード名により決定します。情報の詳細は巻末の付録を参照してください。"
    },
    {
      "key": "9.1.3",
      "context": "main",
      "number": "9.1.3",
      "kind": "rule",
      "depth": 3,
      "text": "あるトークンを‘消去する’とは、そのトークンを現在ある領域から取り除き、そこに存在しない状態にすることを意味します。"
    },
    {
      "key": "9.1.3.1",
      "context": "main",
      "number": "9.1.3.1",
      "kind": "rule",
      "depth": 4,
      "text": "トークンがある領域で消去された場合、その領域を離れたものとみなされます。"
    },
    {
      "key": "9.1.4",
      "context": "main",
      "number": "9.1.4",
      "kind": "rule",
      "depth": 3,
      "text": "トークンは存在できる領域が制限されます。"
    },
    {
      "key": "9.1.4.1",
      "context": "main",
      "number": "9.1.4.1",
      "kind": "rule",
      "depth": 4,
      "text": "種類がフォロワーやアミュレットであるトークンは、EXエリアか場か解決領域でのみ存在できます。"
    },
    {
      "key": "9.1.4.2",
      "context": "main",
      "number": "9.1.4.2",
      "kind": "rule",
      "depth": 4,
      "text": "種類がクレストであるトークンは、EXエリアでのみ存在できます。"
    },
    {
      "key": "9.1.4.3",
      "context": "main",
      "number": "9.1.4.3",
      "kind": "rule",
      "depth": 4,
      "text": "種類がスペルであるトークンは、EXエリアか解決領域でのみ存在できます。"
    },
    {
      "key": "9.1.4.4",
      "context": "main",
      "number": "9.1.4.4",
      "kind": "rule",
      "depth": 4,
      "text": "あるトークンが存在できる領域以外の領域に移動した場合、その移動を行った直後に、その領域で消去されます。この処理はチェックタイミングを待たず、なんらかの効果の途中で移動を行った場合は、その移動の続きを行うよりも前に実行されます。"
    },
    {
      "key": "9.1.5",
      "context": "main",
      "number": "9.1.5",
      "kind": "rule",
      "depth": 3,
      "text": "種類がクレストであるトークンは、以下のルールに従います。"
    },
    {
      "key": "9.1.5.1",
      "context": "main",
      "number": "9.1.5.1",
      "kind": "rule",
      "depth": 4,
      "text": "あるプレイヤーのEXエリアには、同名のクレストは最大で1枚のみ存在できます。"
    },
    {
      "key": "9.1.5.1.1",
      "context": "main",
      "number": "9.1.5.1.1",
      "kind": "rule",
      "depth": 5,
      "text": "あるEXエリアに、そこにすでにあるクレストと同名のクレストを作成する場合、その作成は実行されません。"
    },
    {
      "key": "9.1.5.1.2",
      "context": "main",
      "number": "9.1.5.1.2",
      "kind": "rule",
      "depth": 5,
      "text": "同名のクレストを同じEXエリアに複数同時に作成する場合、そのうち1つのみを作成し、それ以外は作成を行いません。"
    },
    {
      "key": "9.1.5.1.3",
      "context": "main",
      "number": "9.1.5.1.3",
      "kind": "rule",
      "depth": 5,
      "text": "あるEXエリアに、そこにすでにあるクレストと同名のクレストを他のEXエリアから移動しようとする場合、それは移動しません。"
    },
    {
      "key": "9.1.6",
      "context": "main",
      "number": "9.1.6",
      "kind": "rule",
      "depth": 3,
      "text": "ゲーム中でトークンを使用する場合、両プレイヤーの合意の上で、両プレイヤーが明示的に理解でき、他の通常のカードとは区別できるカード状のものを使用してください。"
    },
    {
      "key": "9.2",
      "context": "main",
      "number": "9.2",
      "kind": "section",
      "depth": 2,
      "title": "アドバンスカード",
      "text": ""
    },
    {
      "key": "9.2.1",
      "context": "main",
      "number": "9.2.1",
      "kind": "rule",
      "depth": 3,
      "text": "特殊な種類が‘アドバンス’であるカードは、領域移動に関して以下のルールに従います。"
    },
    {
      "key": "9.2.1.1",
      "context": "main",
      "number": "9.2.1.1",
      "kind": "rule",
      "depth": 4,
      "text": "以下では、特殊な種類が‘アドバンス’であるカードを‘アドバンスカード’と呼びます。"
    },
    {
      "key": "9.2.2",
      "context": "main",
      "number": "9.2.2",
      "kind": "rule",
      "depth": 3,
      "text": "なんらかの処理を行う際に、アドバンスカードが、エボルヴデッキ置き場や場やEXエリアや解決領域以外の領域に移動する場合、その移動直後、その処理の続きを行う前に、そのアドバンスカードをその移動先の領域からエボルヴデッキに表向きに置きます。"
    }
  ]
}
