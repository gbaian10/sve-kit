{
  "format": 1,
  "kind": "comprehensive-rules",
  "version": "1.29.0",
  "nodes": [
    {
      "key": "2",
      "context": "main",
      "number": "2",
      "kind": "chapter",
      "depth": 1,
      "title": "カードの情報",
      "text": "",
      "figure": {
        "page": 2,
        "caption": "フォロワー　（エボルヴフォロワー）　①カード名　②クラス　③種類　④タイプ　⑤コスト　⑥テキスト　⑦攻撃力　⑧体力　⑨トークン情報　⑩イラスト　⑪フレーバー　⑫レアリティ　⑬付帯条項　⑭コラボ名　⑮タイトル　（コラボ名のあるフォロワー）　（タイトルのあるカード）　スペル　アミュレット　リーダー　クレスト"
      }
    },
    {
      "key": "2.1",
      "context": "main",
      "number": "2.1",
      "kind": "section",
      "depth": 2,
      "title": "カード名",
      "text": ""
    },
    {
      "key": "2.1.1",
      "context": "main",
      "number": "2.1.1",
      "kind": "rule",
      "depth": 3,
      "text": "このカードが持つ固有の名称です。"
    },
    {
      "key": "2.1.2",
      "context": "main",
      "number": "2.1.2",
      "kind": "rule",
      "depth": 3,
      "text": "ルールやテキストで‘『（名称）』’という表記がある場合、それは文脈に従い、カード名がその（名称）であるカード、またはその（名称）をカード名の一部に含むカードを意味します。"
    },
    {
      "key": "2.1.2.1",
      "context": "main",
      "number": "2.1.2.1",
      "kind": "rule",
      "depth": 4,
      "text": "これによりカード名の一部を参照する場合、コラボ名（2.14）の一部が参照されることはありません。"
    },
    {
      "key": "2.2",
      "context": "main",
      "number": "2.2",
      "kind": "section",
      "depth": 2,
      "title": "クラス",
      "text": ""
    },
    {
      "key": "2.2.1",
      "context": "main",
      "number": "2.2.1",
      "kind": "rule",
      "depth": 3,
      "text": "このカードが属するクラスです。"
    },
    {
      "key": "2.2.2",
      "context": "main",
      "number": "2.2.2",
      "kind": "rule",
      "depth": 3,
      "text": "クラスはアイコンで表記されます。\n{ニュートラル}ニュートラル\n{エルフ}エルフ\n{ロイヤル}ロイヤル\n{ウィッチ}ウィッチ\n{ドラゴン}ドラゴン\n{ナイトメア}ナイトメア\n{ビショップ}ビショップ"
    },
    {
      "key": "2.2.3",
      "context": "main",
      "number": "2.2.3",
      "kind": "rule",
      "depth": 3,
      "text": "クラスはデッキ構築やカードにより参照されることがあります。"
    },
    {
      "key": "2.3",
      "context": "main",
      "number": "2.3",
      "kind": "section",
      "depth": 2,
      "title": "種類",
      "text": ""
    },
    {
      "key": "2.3.1",
      "context": "main",
      "number": "2.3.1",
      "kind": "rule",
      "depth": 3,
      "text": "このカードの種類を示す情報です。"
    },
    {
      "key": "2.3.2",
      "context": "main",
      "number": "2.3.2",
      "kind": "rule",
      "depth": 3,
      "text": "種類は、‘リーダー’、‘フォロワー’、‘アミュレット’、‘スペル’、‘クレスト’のいずれかです。"
    },
    {
      "key": "2.3.2.1",
      "context": "main",
      "number": "2.3.2.1",
      "kind": "rule",
      "depth": 4,
      "text": "リーダーはカード上では‘Leader’と表記されます。"
    },
    {
      "key": "2.3.2.2",
      "context": "main",
      "number": "2.3.2.2",
      "kind": "rule",
      "depth": 4,
      "text": "フォロワーはカード上では‘Follower’と表記されます。"
    },
    {
      "key": "2.3.2.3",
      "context": "main",
      "number": "2.3.2.3",
      "kind": "rule",
      "depth": 4,
      "text": "アミュレットはカード上では‘Amulet’と表記されます。"
    },
    {
      "key": "2.3.2.4",
      "context": "main",
      "number": "2.3.2.4",
      "kind": "rule",
      "depth": 4,
      "text": "スペルはカード上では‘Spell’と表記されます。"
    },
    {
      "key": "2.3.2.5",
      "context": "main",
      "number": "2.3.2.5",
      "kind": "rule",
      "depth": 4,
      "text": "クレストはカード上では‘Crest’と表記されます。"
    },
    {
      "key": "2.3.3",
      "context": "main",
      "number": "2.3.3",
      "kind": "rule",
      "depth": 3,
      "text": "一部のカードは特殊な種類を持ちます。"
    },
    {
      "key": "2.3.3.1",
      "context": "main",
      "number": "2.3.3.1",
      "kind": "rule",
      "depth": 4,
      "text": "特殊な種類‘エボルヴ’はカード上では‘EVOLVE’と表記されます。"
    },
    {
      "key": "2.3.3.2",
      "context": "main",
      "number": "2.3.3.2",
      "kind": "rule",
      "depth": 4,
      "text": "特殊な種類‘アドバンス’はカード上では‘ADVANCE’と表記されます。"
    },
    {
      "key": "2.3.4",
      "context": "main",
      "number": "2.3.4",
      "kind": "rule",
      "depth": 3,
      "text": "ルールや能力や効果が単に種類の名称のみを参照する場合、それはその種類を持つカードを参照します。"
    },
    {
      "key": "2.4",
      "context": "main",
      "number": "2.4",
      "kind": "section",
      "depth": 2,
      "title": "タイプ",
      "text": ""
    },
    {
      "key": "2.4.1",
      "context": "main",
      "number": "2.4.1",
      "kind": "rule",
      "depth": 3,
      "text": "このカードが持つ特徴を示す語です。"
    },
    {
      "key": "2.4.2",
      "context": "main",
      "number": "2.4.2",
      "kind": "rule",
      "depth": 3,
      "text": "タイプはルール上の意味を持ちませんが、他のカードにより参照されることがあります。"
    },
    {
      "key": "2.4.3",
      "context": "main",
      "number": "2.4.3",
      "kind": "rule",
      "depth": 3,
      "text": "カードが複数のタイプを持つことがあります。その場合、各タイプを‘・’で区切って表記します。",
      "changed": true
    },
    {
      "key": "2.4.3.1",
      "context": "main",
      "number": "2.4.3.1",
      "kind": "rule",
      "depth": 4,
      "text": "タイプに‘〈〉’（山括弧）で囲まれている語がある場合、それは山括弧も含めて1つのタイプです。その山括弧内に含まれる‘・’は語に含まれ、タイプの区切りではありません。",
      "changed": true
    },
    {
      "key": "2.5",
      "context": "main",
      "number": "2.5",
      "kind": "section",
      "depth": 2,
      "title": "コスト",
      "text": ""
    },
    {
      "key": "2.5.1",
      "context": "main",
      "number": "2.5.1",
      "kind": "rule",
      "depth": 3,
      "text": "このカードをプレイする際に支払う必要のあるPPの数です（10.4.3）。"
    },
    {
      "key": "2.6",
      "context": "main",
      "number": "2.6",
      "kind": "section",
      "depth": 2,
      "title": "カードテキスト",
      "text": ""
    },
    {
      "key": "2.6.1",
      "context": "main",
      "number": "2.6.1",
      "kind": "rule",
      "depth": 3,
      "text": "このカードが持つ固有の処理を示す情報です。"
    },
    {
      "key": "2.6.2",
      "context": "main",
      "number": "2.6.2",
      "kind": "rule",
      "depth": 3,
      "text": "テキストの中に、（）（丸括弧）で囲まれた、能力を詳しく説明したものが存在することがあります。これは注釈文と呼ばれるものです。注釈文はテキストの一部ですが、あくまで能力の解説を目的とした意味を持つだけで、ゲームには影響しません。"
    },
    {
      "key": "2.7",
      "context": "main",
      "number": "2.7",
      "kind": "section",
      "depth": 2,
      "title": "攻撃力",
      "text": ""
    },
    {
      "key": "2.7.1",
      "context": "main",
      "number": "2.7.1",
      "kind": "rule",
      "depth": 3,
      "text": "このカードが攻撃した際に与えるダメージの基準となる値です。"
    },
    {
      "key": "2.7.1.1",
      "context": "main",
      "number": "2.7.1.1",
      "kind": "rule",
      "depth": 4,
      "text": "テキストでは、‘攻撃力’は{攻撃力}のアイコンで示されることがあります。"
    },
    {
      "key": "2.8",
      "context": "main",
      "number": "2.8",
      "kind": "section",
      "depth": 2,
      "title": "体力",
      "text": ""
    },
    {
      "key": "2.8.1",
      "context": "main",
      "number": "2.8.1",
      "kind": "rule",
      "depth": 3,
      "text": "このカードをダメージにより破壊するために与える必要のあるダメージ数です。"
    },
    {
      "key": "2.8.1.1",
      "context": "main",
      "number": "2.8.1.1",
      "kind": "rule",
      "depth": 4,
      "text": "テキストでは、‘体力’は{体力}のアイコンで示されることがあります。"
    },
    {
      "key": "2.8.2",
      "context": "main",
      "number": "2.8.2",
      "kind": "rule",
      "depth": 3,
      "text": "フォロワーやリーダーがダメージを受けた場合、そのカードの体力の値が減少します（5.14.1）。"
    },
    {
      "key": "2.8.3",
      "context": "main",
      "number": "2.8.3",
      "kind": "rule",
      "depth": 3,
      "text": "リーダーには表記はありませんが、リーダーも体力を持ちます。"
    },
    {
      "key": "2.8.3.1",
      "context": "main",
      "number": "2.8.3.1",
      "kind": "rule",
      "depth": 4,
      "text": "特に表記がない限り、リーダーの体力は20です。"
    },
    {
      "key": "2.9",
      "context": "main",
      "number": "2.9",
      "kind": "section",
      "depth": 2,
      "title": "トークン情報",
      "text": ""
    },
    {
      "key": "2.9.1",
      "context": "main",
      "number": "2.9.1",
      "kind": "rule",
      "depth": 3,
      "text": "このカードの効果により参照されるトークンの情報です。"
    },
    {
      "key": "2.9.2",
      "context": "main",
      "number": "2.9.2",
      "kind": "rule",
      "depth": 3,
      "text": "これはプレイヤーがトークンの情報を参照する目的で表記されており、ルール上は意味を持ちません。"
    },
    {
      "key": "2.10",
      "context": "main",
      "number": "2.10",
      "kind": "section",
      "depth": 2,
      "title": "イラスト",
      "text": ""
    },
    {
      "key": "2.10.1",
      "context": "main",
      "number": "2.10.1",
      "kind": "rule",
      "depth": 3,
      "text": "このカードの内容をイメージしたイラストです。"
    },
    {
      "key": "2.10.2",
      "context": "main",
      "number": "2.10.2",
      "kind": "rule",
      "depth": 3,
      "text": "イラストは、ゲーム上は特に意味を持ちません。"
    },
    {
      "key": "2.11",
      "context": "main",
      "number": "2.11",
      "kind": "section",
      "depth": 2,
      "title": "フレーバー",
      "text": ""
    },
    {
      "key": "2.11.1",
      "context": "main",
      "number": "2.11.1",
      "kind": "rule",
      "depth": 3,
      "text": "このカードの内容をイメージした文章です。フレーバーは、カード名の上の線で区切られた部分に表記されています。"
    },
    {
      "key": "2.11.2",
      "context": "main",
      "number": "2.11.2",
      "kind": "rule",
      "depth": 3,
      "text": "フレーバーは、ゲーム上は特に意味を持ちません。"
    },
    {
      "key": "2.12",
      "context": "main",
      "number": "2.12",
      "kind": "section",
      "depth": 2,
      "title": "レアリティ",
      "text": ""
    },
    {
      "key": "2.12.1",
      "context": "main",
      "number": "2.12.1",
      "kind": "rule",
      "depth": 3,
      "text": "このカードの稀少度を意味します。"
    },
    {
      "key": "2.12.2",
      "context": "main",
      "number": "2.12.2",
      "kind": "rule",
      "depth": 3,
      "text": "レアリティは、ゲーム上は特に意味を持ちません。"
    },
    {
      "key": "2.13",
      "context": "main",
      "number": "2.13",
      "kind": "section",
      "depth": 2,
      "title": "付帯条項",
      "text": ""
    },
    {
      "key": "2.13.1",
      "context": "main",
      "number": "2.13.1",
      "kind": "rule",
      "depth": 3,
      "text": "このカードのコレクター番号、タイトル、カードの著作権表記等、これまでに示された内容以外の表記をまとめて‘付帯条項’と呼びます。"
    },
    {
      "key": "2.13.2",
      "context": "main",
      "number": "2.13.2",
      "kind": "rule",
      "depth": 3,
      "text": "付帯情報は、以下の例外を除き、ゲーム上は特に意味を持ちません。"
    },
    {
      "key": "2.13.2.1",
      "context": "main",
      "number": "2.13.2.1",
      "kind": "rule",
      "depth": 4,
      "text": "タイトルはデッキ構築の際に参照されることがあります。"
    },
    {
      "key": "2.13.2.2",
      "context": "main",
      "number": "2.13.2.2",
      "kind": "rule",
      "depth": 4,
      "text": "コレクター番号は、両面カード（2.15）の第1面と第2面を区別する際に参照されることがあります。"
    },
    {
      "key": "2.14",
      "context": "main",
      "number": "2.14",
      "kind": "section",
      "depth": 2,
      "title": "コラボ名",
      "text": ""
    },
    {
      "key": "2.14.1",
      "context": "main",
      "number": "2.14.1",
      "kind": "rule",
      "depth": 3,
      "text": "一部のカードは、通常のカード名に加えて別名であるコラボ名を持ちます。"
    },
    {
      "key": "2.14.2",
      "context": "main",
      "number": "2.14.2",
      "kind": "rule",
      "depth": 3,
      "text": "能力や効果がいずれかのカードのコラボ名をその完全なカード名で参照する場合、それはそのコラボ名を持つカードのカード名を参照します。"
    },
    {
      "key": "2.15",
      "context": "main",
      "number": "2.15",
      "kind": "section",
      "depth": 2,
      "title": "両面カード",
      "text": ""
    },
    {
      "key": "2.15.1",
      "context": "main",
      "number": "2.15.1",
      "kind": "rule",
      "depth": 3,
      "text": "一部のカードは、カードの両面に情報を持ちます。このようなカードを‘両面カード’と言います。"
    },
    {
      "key": "2.15.2",
      "context": "main",
      "number": "2.15.2",
      "kind": "rule",
      "depth": 3,
      "text": "両面カードの各面は、コレクター番号がある面を第1面、もう一方の面を第2面と呼びます。"
    },
    {
      "key": "2.15.2.1",
      "context": "main",
      "number": "2.15.2.1",
      "kind": "rule",
      "depth": 4,
      "text": "場（4.4）や進化領域（4.12）やエボルヴデッキ置き場（4.6）以外の領域にある両面カードは、その第1面の情報を持つものとして扱います。"
    },
    {
      "key": "2.15.3",
      "context": "main",
      "number": "2.15.3",
      "kind": "rule",
      "depth": 3,
      "text": "場や進化領域に両面カード（2.15）を置く際は、ルールや効果により指定された面がプレイヤーに見えるように置きます。"
    },
    {
      "key": "2.15.3.1",
      "context": "main",
      "number": "2.15.3.1",
      "kind": "rule",
      "depth": 4,
      "text": "場や進化領域にある両面カードの情報を参照する場合、実際にプレイヤーに見えている面の情報を参照します。"
    }
  ]
}
