{
  "format": 1,
  "kind": "comprehensive-rules",
  "version": "1.29.0",
  "nodes": [
    {
      "key": "3",
      "context": "main",
      "number": "3",
      "kind": "chapter",
      "depth": 1,
      "title": "プレイヤーに関する情報",
      "text": ""
    },
    {
      "key": "3.1",
      "context": "main",
      "number": "3.1",
      "kind": "section",
      "depth": 2,
      "title": "オーナーとマスター",
      "text": ""
    },
    {
      "key": "3.1.1",
      "context": "main",
      "number": "3.1.1",
      "kind": "rule",
      "depth": 3,
      "text": "オーナーとは、カードの物理的な所有者を指します。あるカードのオーナーとは、そのカードをデッキに入れてゲームを開始したプレイヤーを指します。ゲームが終了した段階で、各プレイヤーは自分がオーナーであるカードをすべて取り戻します。"
    },
    {
      "key": "3.1.2",
      "context": "main",
      "number": "3.1.2",
      "kind": "rule",
      "depth": 3,
      "text": "マスターとは、カードや能力や効果等を現在使用しているプレイヤーを意味します。いずれかの領域に置かれているカードのマスターとは、その領域が属しているプレイヤーを指します。"
    },
    {
      "key": "3.1.2.1",
      "context": "main",
      "number": "3.1.2.1",
      "kind": "rule",
      "depth": 4,
      "text": "永続能力のマスターとは、その能力を有するカードやその能力を発生した効果のマスターを指します。"
    },
    {
      "key": "3.1.2.2",
      "context": "main",
      "number": "3.1.2.2",
      "kind": "rule",
      "depth": 4,
      "text": "起動能力のマスターとは、それをプレイしたプレイヤーを指します。"
    },
    {
      "key": "3.1.2.3",
      "context": "main",
      "number": "3.1.2.3",
      "kind": "rule",
      "depth": 4,
      "text": "自動能力のマスターとは、その能力を有するカードやその能力を発生した効果のマスターを指します。"
    },
    {
      "key": "3.1.2.4",
      "context": "main",
      "number": "3.1.2.4",
      "kind": "rule",
      "depth": 4,
      "text": "効果のマスターとは、その効果を発生した能力のマスターを指します。"
    },
    {
      "key": "3.1.2.4.1",
      "context": "main",
      "number": "3.1.2.4.1",
      "kind": "rule",
      "depth": 5,
      "text": "ある効果により特にプレイヤーが指定されずになんらかの行動を行うよう指示されている場合、その効果のマスターがその指示を実行します。"
    },
    {
      "key": "3.2",
      "context": "main",
      "number": "3.2",
      "kind": "section",
      "depth": 2,
      "title": "PP/EP/SEP",
      "text": ""
    },
    {
      "key": "3.2.1",
      "context": "main",
      "number": "3.2.1",
      "kind": "rule",
      "depth": 3,
      "text": "PP（プレイポイント）とPP最大値とEP（エボルヴポイント）は、それぞれのプレイヤーが持つ数値情報です。"
    },
    {
      "key": "3.2.2",
      "context": "main",
      "number": "3.2.2",
      "kind": "rule",
      "depth": 3,
      "text": "PPは、プレイヤーがカードをプレイしたり進化を行ったりするためのコストとして消費する数値です（10.4.3）。"
    },
    {
      "key": "3.2.3",
      "context": "main",
      "number": "3.2.3",
      "kind": "rule",
      "depth": 3,
      "text": "PP最大値は、プレイヤーがターンの最初に受け取るPPの値です。"
    },
    {
      "key": "3.2.4",
      "context": "main",
      "number": "3.2.4",
      "kind": "rule",
      "depth": 3,
      "text": "PPとPP最大値には下限と上限があります。ゲーム中にPPやPP最大値がこの上限を上回るか下限を下回る場合、それはその超過した値ではなく上限や下限の値になります。"
    },
    {
      "key": "3.2.4.1",
      "context": "main",
      "number": "3.2.4.1",
      "kind": "rule",
      "depth": 4,
      "text": "PP最大値の下限は0で、上限は10です。"
    },
    {
      "key": "3.2.4.2",
      "context": "main",
      "number": "3.2.4.2",
      "kind": "rule",
      "depth": 4,
      "text": "PPの下限は0で、上限は現在のPP最大値です。"
    },
    {
      "key": "3.2.5",
      "context": "main",
      "number": "3.2.5",
      "kind": "rule",
      "depth": 3,
      "text": "EPは、プレイヤーが進化能力（12.1.2.1）をプレイする際に、PPの代わりに消費することができる数値です（12.2.2）。"
    },
    {
      "key": "3.2.5.1",
      "context": "main",
      "number": "3.2.5.1",
      "kind": "rule",
      "depth": 4,
      "text": "EPの下限は0です。"
    },
    {
      "key": "3.2.6",
      "context": "main",
      "number": "3.2.6",
      "kind": "rule",
      "depth": 3,
      "text": "SEPは、プレイヤーが超進化（12.2.4）を行う際に消費する数値です。"
    },
    {
      "key": "3.2.6.1",
      "context": "main",
      "number": "3.2.6.1",
      "kind": "rule",
      "depth": 4,
      "text": "SEPの下限は0です。"
    },
    {
      "key": "3.3",
      "context": "main",
      "number": "3.3",
      "kind": "section",
      "depth": 2,
      "title": "経過ターン数",
      "text": ""
    },
    {
      "key": "3.3.1",
      "context": "main",
      "number": "3.3.1",
      "kind": "rule",
      "depth": 3,
      "text": "経過ターン数は、それぞれのプレイヤーが持つ数値情報です。"
    },
    {
      "key": "3.3.2",
      "context": "main",
      "number": "3.3.2",
      "kind": "rule",
      "depth": 3,
      "text": "あるプレイヤーの経過ターン数を参照する場合、そのプレイヤーがターンプレイヤーとして、そのターンに初めてスタートフェイズ（7.2）を開始した回数を参照します。"
    },
    {
      "key": "3.3.2.1",
      "context": "main",
      "number": "3.3.2.1",
      "kind": "rule",
      "depth": 4,
      "text": "あるプレイヤーがターンをスキップした（5.26）場合、そのターンは経過ターン数に数えません。"
    },
    {
      "key": "3.3.2.2",
      "context": "main",
      "number": "3.3.2.2",
      "kind": "rule",
      "depth": 4,
      "text": "あるプレイヤーが追加ターンを行った（5.28）場合、そのターンは経過ターンに数えます。"
    }
  ]
}
