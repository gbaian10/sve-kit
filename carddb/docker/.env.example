# Copy to .env (git-ignored). Absolute, symlink-free host paths; mounted at the same paths.
SVE_EXPORT_DIR=/path/to/export/public
SVE_CARDDB_PRIVATE_DIR=/path/to/export/private
SVE_IMAGE_INDEX=/path/to/image-index/<sha256>.json

# Hard caps for one text export.
EXPORT_CPUS=2
EXPORT_MEMORY=16g

EXPORT_BROTLI=1
EXPORT_PROFILE=0
# Set to 100 for a small translation sample before profiling a full export.
SVE_PROFILE_FIELD_STRIDE=
