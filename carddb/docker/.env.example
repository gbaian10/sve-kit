# Copy to .env (git-ignored). Absolute, symlink-free host paths; mounted at the same paths.
SVE_REPO=/path/to/sve-kit
SVE_ARCHIVE=/path/to/source-archive
SVE_EXPORT_DIR=/path/to/export/public
SVE_CARDDB_PRIVATE_DIR=/path/to/export/private
SVE_IMAGE_ASSETS_DIR=/path/to/webp-library
SVE_IMAGE_CACHE_DIR=/path/to/recipe-cache

# Hard caps for one export, and the export's own worker count.
EXPORT_CPUS=2
EXPORT_MEMORY=16g
EXPORT_WORKERS=2

EXPORT_IMAGES=1
EXPORT_BROTLI=1
EXPORT_PROFILE=0
# Set to 100 for a small translation sample before profiling a full export.
SVE_PROFILE_FIELD_STRIDE=
