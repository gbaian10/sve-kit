root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{rs,toml,py}]
indent_size = 4

[*.{json,yaml,yml,md}]
indent_size = 2

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Fixtures are verbatim copies of real pages; keep them byte-for-byte.
[carddb/tests/fixtures/**]
trim_trailing_whitespace = unset
insert_final_newline = unset
